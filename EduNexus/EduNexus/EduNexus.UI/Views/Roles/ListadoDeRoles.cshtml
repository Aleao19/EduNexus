@model IEnumerable<EduNexus.Abstracciones.ModelosParaUI.Roles.RolDto>

@{
    ViewBag.Title = "Listado de roles";
    int total = Model.Count();
}

<div class="row align-items-center mb-3">
    <div class="col">
        <h1 class="mb-0">Roles</h1>
        <p class="text-secondary mb-0">Roles precargados del sistema y sus permisos de acceso. Los permisos de cada rol son fijos.</p>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h3 class="card-title mb-0">Listado</h3>
        <div class="text-secondary small">@total rol(es)</div>
    </div>

    @if (!Model.Any())
    {
        <div class="card-body">
            <div class="empty">
                <p class="empty-title">No hay roles registrados</p>
                <p class="empty-subtitle text-secondary">Los roles se precargan en la base de datos.</p>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vcenter card-table" id="myTable">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.nombre)</th>
                        <th>Permisos</th>
                        <th>@Html.DisplayNameFor(model => model.cantidadUsuarios)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-medium">@item.nombre</td>
                            <td class="text-secondary">@EduNexus.UI.Models.RolesSistema.DescripcionPermisos(item.nombre)</td>
                            <td><span class="badge bg-blue-lt">@item.cantidadUsuarios</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section scripts {
    <script src="~/Scripts/General/General.js"></script>
}
