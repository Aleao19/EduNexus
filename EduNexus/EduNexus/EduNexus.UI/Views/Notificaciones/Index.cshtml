@model IEnumerable<EduNexus.UI.Models.Identity.NotificacionEntity>

@{
    ViewBag.Title = "Mis notificaciones";

    int total = ViewBag.TotalNotificaciones != null
        ? (int)ViewBag.TotalNotificaciones : 0;

    int noLeidas = ViewBag.NoLeidas != null
        ? (int)ViewBag.NoLeidas : 0;
}

<style>
    .notificaciones-contenedor {
        max-width: 1100px;
        margin: 30px auto;
        padding: 20px;
    }

    .notificaciones-encabezado {
        margin-bottom: 25px;
    }

    .notificaciones-encabezado h2 {
        color: #24364b;
        font-weight: bold;
        margin-bottom: 8px;
    }

    .notificaciones-encabezado p {
        color: #64748b;
    }

    .resumen-notificaciones {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 25px;
    }

    .tarjeta-resumen {
        flex: 1;
        min-width: 180px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 3px 8px rgba(0,0,0,0.05);
    }

    .tarjeta-resumen h3 {
        font-size: 30px;
        font-weight: bold;
        color: #2563eb;
        margin: 0;
    }

    .tarjeta-resumen p {
        color: #64748b;
        margin: 8px 0 0;
    }

    .acciones-notificaciones {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 20px;
    }

    .notificacion {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-left: 5px solid #94a3b8;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 15px;
    }

    .notificacion-no-leida {
        background: #eff6ff;
        border-left-color: #2563eb;
    }

    .notificacion-titulo {
        font-size: 18px;
        font-weight: bold;
        color: #24364b;
        margin-bottom: 10px;
    }

    .notificacion-mensaje {
        color: #475569;
        line-height: 1.6;
    }

    .notificacion-fecha {
        font-size: 13px;
        color: #64748b;
        margin-top: 10px;
    }

    .notificacion-acciones {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 15px;
    }

    .estado-nueva {
        display: inline-block;
        background: #2563eb;
        color: white;
        padding: 4px 10px;
        border-radius: 15px;
        font-size: 12px;
        margin-left: 8px;
    }

    .estado-leida {
        display: inline-block;
        background: #e2e8f0;
        color: #475569;
        padding: 4px 10px;
        border-radius: 15px;
        font-size: 12px;
        margin-left: 8px;
    }

    .sin-notificaciones {
        text-align: center;
        padding: 45px 20px;
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
        border-radius: 12px;
        color: #64748b;
    }

    .formulario-en-linea {
        display: inline-block;
        margin: 0;
    }
</style>

<div class="notificaciones-contenedor">

    <div class="notificaciones-encabezado">

        <h2>Mis notificaciones</h2>

        <p>
            Consulte las notificaciones de asistencia
            correspondientes a los estudiantes asociados
            a su cuenta.
        </p>

    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["MensajeError"]
        </div>
    }

    <div class="resumen-notificaciones">

        <div class="tarjeta-resumen">

            <h3>@total</h3>

            <p>Total de notificaciones</p>

        </div>

        <div class="tarjeta-resumen">

            <h3>@noLeidas</h3>

            <p>Notificaciones no leídas</p>

        </div>

        <div class="tarjeta-resumen">

            <h3>@(total - noLeidas)</h3>

            <p>Notificaciones leídas</p>

        </div>

    </div>

    @if (noLeidas > 0)
    {
        <div class="acciones-notificaciones">

            @using (Html.BeginForm(
                "MarcarTodasComoLeidas",
                "Notificaciones",
                FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-primary">

                    Marcar todas como leídas

                </button>
            }

        </div>
    }

    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="notificacion
                 @(!item.leida ? "notificacion-no-leida" : "")">

                <div class="notificacion-titulo">

                    @item.titulo

                    @if (!item.leida)
                    {
                        <span class="estado-nueva">
                            Nueva
                        </span>
                    }
                    else
                    {
                        <span class="estado-leida">
                            Leída
                        </span>
                    }

                </div>

                <div class="notificacion-mensaje">

                    @item.mensaje

                </div>

                <div class="notificacion-fecha">

                    Recibida:

                    @item.fecha_creacion.ToString(
                        "dd/MM/yyyy HH:mm")

                </div>

                <div class="notificacion-acciones">

                    <a href="@Url.Action(
                        "Detalle",
                        "Notificaciones",
                        new { id = item.id_notificacion })"
                       class="btn btn-primary">

                        Ver detalle

                    </a>

                    @if (!item.leida)
                    {
                        using (Html.BeginForm(
                            "MarcarComoLeida",
                            "Notificaciones",
                            FormMethod.Post,
                            new
                            {
                                @class = "formulario-en-linea"
                            }))
                        {
                            @Html.AntiForgeryToken()

                            @Html.Hidden(
                                "id",
                                item.id_notificacion)

                            <button type="submit"
                                    class="btn btn-default">

                                Marcar como leída

                            </button>
                        }
                    }

                </div>

            </div>
        }
    }
    else
    {
        <div class="sin-notificaciones">

            <h3>No tiene notificaciones</h3>

            <p>
                Cuando se registre una ausencia de alguno
                de los estudiantes asociados a su cuenta,
                podrá consultar la notificación aquí.
            </p>

        </div>
    }

</div>