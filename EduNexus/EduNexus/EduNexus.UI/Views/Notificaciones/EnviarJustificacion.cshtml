@model IEnumerable<EduNexus.UI.Models.Identity.AsistenciaEntity>

@using System
@using System.Linq
@using System.Collections.Generic

@{
    ViewBag.Title = "Enviar justificación";

    var nombresEstudiantes =
        ViewBag.NombresEstudiantes
        as Dictionary<string, string>
        ?? new Dictionary<string, string>();

    var nombresMaterias =
        ViewBag.NombresMaterias
        as Dictionary<int, string>
        ?? new Dictionary<int, string>();

    int totalAusencias =
        Model != null ? Model.Count() : 0;
}

<style>

    .justificacion-contenedor {
        max-width: 1200px;
        margin: 30px auto;
        padding: 20px;
    }

    .justificacion-encabezado {
        margin-bottom: 25px;
    }

    .justificacion-encabezado h2 {
        color: #24364b;
        font-weight: bold;
    }

    .justificacion-encabezado p {
        color: #64748b;
    }

    .justificacion-panel {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 25px;
        box-shadow: 0 3px 8px rgba(0,0,0,0.05);
    }

    .justificacion-filtros {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: 15px;
    }

    .justificacion-filtro {
        flex: 1;
        min-width: 220px;
    }

    .justificacion-filtro label {
        display: block;
        font-weight: bold;
        color: #334155;
        margin-bottom: 8px;
    }

    .justificacion-filtro select {
        width: 100%;
        max-width: 100%;
    }

    .justificacion-resumen {
        background: #eff6ff;
        border-left: 5px solid #2563eb;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 25px;
    }

    .justificacion-resumen h3 {
        color: #1e40af;
        font-weight: bold;
        margin: 5px 0;
    }

    .justificacion-resumen p {
        color: #475569;
        margin: 0;
    }

    .justificacion-tarjeta {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        margin-bottom: 20px;
        overflow: hidden;
        box-shadow: 0 3px 8px rgba(0,0,0,0.05);
    }

    .justificacion-tarjeta-encabezado {
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        padding: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .justificacion-tarjeta-encabezado h4 {
        color: #24364b;
        font-weight: bold;
        margin: 0;
    }

    .justificacion-tarjeta-cuerpo {
        padding: 25px;
    }

    .justificacion-datos {
        display: grid;
        grid-template-columns: repeat(
            auto-fit, minmax(180px, 1fr));
        gap: 20px;
        margin-bottom: 20px;
    }

    .justificacion-dato {
        background: #f8fafc;
        border-radius: 8px;
        padding: 15px;
    }

    .justificacion-dato span {
        display: block;
        color: #64748b;
        font-size: 13px;
        margin-bottom: 5px;
    }

    .justificacion-dato strong {
        color: #334155;
        font-size: 15px;
    }

    .estado-ausencia {
        background: #fee2e2;
        color: #b91c1c;
        border-radius: 20px;
        padding: 8px 14px;
        font-size: 13px;
        font-weight: bold;
    }

    .justificacion-formulario label {
        display: block;
        font-weight: bold;
        color: #334155;
        margin-bottom: 10px;
    }

    .justificacion-formulario textarea {
        width: 100%;
        max-width: 100%;
        min-height: 120px;
        resize: vertical;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 12px;
    }

    .justificacion-formulario textarea:focus {
        outline: none;
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37,99,235,0.10);
    }

    .contador-caracteres {
        text-align: right;
        font-size: 12px;
        color: #64748b;
        margin-top: 5px;
    }

    .justificacion-acciones {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 20px;
    }

    .justificacion-vacio {
        text-align: center;
        background: #f0fdf4;
        border: 1px dashed #86efac;
        border-radius: 12px;
        padding: 40px;
        color: #166534;
    }

    .justificacion-vacio h3 {
        font-weight: bold;
    }

    .justificacion-informacion {
        background: #fffbeb;
        border-left: 5px solid #d97706;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 25px;
        color: #92400e;
    }

    .justificacion-informacion h5 {
        font-weight: bold;
        margin-bottom: 10px;
    }

    .justificacion-informacion p {
        margin-bottom: 5px;
    }

    .mensaje-validacion {
        color: #dc2626;
        font-size: 13px;
        margin-top: 8px;
    }

    @@media (max-width: 600px) {

        .justificacion-contenedor {
            padding: 10px;
            margin: 15px auto;
        }

        .justificacion-panel,
        .justificacion-tarjeta-cuerpo {
            padding: 15px;
        }

        .justificacion-acciones .btn {
            width: 100%;
        }
    }

</style>

<div class="justificacion-contenedor">

    <!-- ENCABEZADO -->

    <div class="justificacion-encabezado">

        <h2>Enviar justificación de ausencia</h2>

        <p>
            Consulte las ausencias pendientes de sus
            estudiantes y envíe una justificación
            para revisión del docente.
        </p>

        <div class="justificacion-acciones">

            <a href="@Url.Action(
                "HistorialJustificaciones",
                "Notificaciones")"
               class="btn btn-outline-primary">

                Historial de justificaciones

            </a>

            <a href="@Url.Action(
                "Index",
                "Notificaciones")"
               class="btn btn-secondary">

                Ver notificaciones

            </a>

        </div>

    </div>

    <!-- INFORMACIÓN DEL PROCESO -->

    <div class="justificacion-informacion">

        <h5>Información importante</h5>

        <p>
            Las justificaciones enviadas quedarán
            pendientes de revisión por el docente.
        </p>

        <p>
            El envío de una justificación no modifica
            automáticamente el estado de asistencia.
        </p>

        <p>
            Puede consultar el resultado de la revisión
            desde el historial de justificaciones.
        </p>

    </div>

    <!-- FILTROS -->

    <div class="justificacion-panel">

        <h4>Filtrar ausencias</h4>

        <hr />

        @using (Html.BeginForm(
            "EnviarJustificacion",
            "Notificaciones",
            FormMethod.Get))
        {
            <div class="justificacion-filtros">

                <div class="justificacion-filtro">

                    <label for="id_estudiante">

                        Estudiante

                    </label>

                    @Html.DropDownList(
                        "id_estudiante",
                        (SelectList)ViewBag.Estudiantes,
                        "Todos los estudiantes",
                        new
                        {
                            @class = "form-select",
                            id = "id_estudiante"
                        })

                </div>

                <div>

                    <button type="submit"
                            class="btn btn-primary">

                        Buscar ausencias

                    </button>

                </div>

                <div>

                    <a href="@Url.Action(
                        "EnviarJustificacion",
                        "Notificaciones")"
                       class="btn btn-secondary">

                        Limpiar filtro

                    </a>

                </div>

            </div>
        }

    </div>

    <!-- RESUMEN -->

    <div class="justificacion-resumen">

        <p>Ausencias disponibles para justificar</p>

        <h3>@totalAusencias</h3>

        <p>
            No se incluyen ausencias que ya tengan
            una justificación pendiente de revisión.
        </p>

    </div>

    <!-- LISTADO DE AUSENCIAS -->

    @if (Model == null || !Model.Any())
    {
        <div class="justificacion-vacio">

            <h3>No hay ausencias pendientes</h3>

            <p>
                No se encontraron ausencias disponibles
                para justificar con los filtros seleccionados.
            </p>

            <a href="@Url.Action(
                "HistorialJustificaciones",
                "Notificaciones")"
               class="btn btn-outline-success">

                Consultar historial

            </a>

        </div>
    }
    else
    {
        foreach (var ausencia in Model)
        {
            string nombreEstudiante =
                "Estudiante no disponible";

            string nombreMateria =
                "Materia no disponible";

            if (!string.IsNullOrEmpty(
                    ausencia.fk_id_usuario) &&
                nombresEstudiantes.ContainsKey(
                    ausencia.fk_id_usuario))
            {
                nombreEstudiante =
                    nombresEstudiantes[
                        ausencia.fk_id_usuario];
            }

            if (nombresMaterias.ContainsKey(
                ausencia.fk_id_materia))
            {
                nombreMateria =
                    nombresMaterias[
                        ausencia.fk_id_materia];
            }

            <div class="justificacion-tarjeta">

                <!-- ENCABEZADO DE LA AUSENCIA -->

                <div class="justificacion-tarjeta-encabezado">

                    <h4>@nombreEstudiante</h4>

                    <span class="estado-ausencia">

                        @ausencia.estado

                    </span>

                </div>

                <div class="justificacion-tarjeta-cuerpo">

                    <!-- INFORMACIÓN DE LA AUSENCIA -->

                    <div class="justificacion-datos">

                        <div class="justificacion-dato">

                            <span>Estudiante</span>

                            <strong>
                                @nombreEstudiante
                            </strong>

                        </div>

                        <div class="justificacion-dato">

                            <span>Materia</span>

                            <strong>
                                @nombreMateria
                            </strong>

                        </div>

                        <div class="justificacion-dato">

                            <span>Fecha de ausencia</span>

                            <strong>
                                @ausencia.fecha.ToString(
                                    "dd/MM/yyyy")
                            </strong>

                        </div>

                        <div class="justificacion-dato">

                            <span>Estado de asistencia</span>

                            <strong>
                                @ausencia.estado
                            </strong>

                        </div>

                    </div>

                    <hr />

                    <!-- FORMULARIO DE JUSTIFICACIÓN -->

                    @using (Html.BeginForm(
                        "EnviarJustificacionDirecta",
                        "Notificaciones",
                        FormMethod.Post,
                        new
                        {
                            @class =
                                "justificacion-formulario"
                        }))
                    {
                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id_asistencia"
                               value="@ausencia.id_asistencia" />

                        <div class="form-group">

                            <label for="motivo_@ausencia.id_asistencia">

                                Motivo de la ausencia *

                            </label>

                            <textarea
                                id="motivo_@ausencia.id_asistencia"
                                name="motivo"
                                class="form-control motivo-justificacion"
                                maxlength="500"
                                required
                                placeholder="Explique el motivo por el cual el estudiante no asistió a clases."></textarea>

                            <div class="contador-caracteres">

                                <span class="cantidad-caracteres">
                                    0
                                </span>

                                / 500 caracteres

                            </div>

                            <div class="mensaje-validacion"
                                 role="alert"
                                 aria-live="polite">
                            </div>

                        </div>

                        <div class="justificacion-acciones">

                            <button type="submit"
                                    class="btn btn-primary btn-enviar">

                                Enviar justificación

                            </button>

                            <button type="reset"
                                    class="btn btn-outline-secondary">

                                Limpiar motivo

                            </button>

                        </div>
                    }

                </div>

            </div>
        }
    }

    <!-- BOTONES INFERIORES -->

    <div class="justificacion-acciones">

        <a href="@Url.Action(
            "HistorialJustificaciones",
            "Notificaciones")"
           class="btn btn-outline-primary">

            Historial de justificaciones

        </a>

        <a href="@Url.Action(
            "Index",
            "Home")"
           class="btn btn-secondary">

            Volver al inicio

        </a>

    </div>

</div>

@section scripts {

    <script>

        $(document).ready(function () {

            // ========================================
            // CONTADOR DE CARACTERES
            // ========================================

            $(".motivo-justificacion").on(
                "input",
                function () {

                    var textarea = $(this);

                    var formulario =
                        textarea.closest("form");

                    var cantidad =
                        textarea.val().length;

                    formulario
                        .find(".cantidad-caracteres")
                        .text(cantidad);

                    formulario
                        .find(".mensaje-validacion")
                        .text("");

                    if (cantidad >= 500) {

                        formulario
                            .find(".contador-caracteres")
                            .css("color", "#dc2626");

                    } else {

                        formulario
                            .find(".contador-caracteres")
                            .css("color", "#64748b");
                    }
                });

            // ========================================
            // VALIDAR ENVÍO DE JUSTIFICACIÓN
            // ========================================

            $(".justificacion-formulario").on(
                "submit",
                function (event) {

                    var formulario = $(this);

                    var textarea = formulario.find(
                        ".motivo-justificacion");

                    var motivo = textarea.val().trim();

                    var mensaje = formulario.find(
                        ".mensaje-validacion");

                    var boton = formulario.find(
                        ".btn-enviar");

                    mensaje.text("");

                    if (motivo.length === 0) {

                        event.preventDefault();

                        mensaje.text(
                            "Debe ingresar el motivo " +
                            "de la ausencia."
                        );

                        textarea.focus();

                        return;
                    }

                    if (motivo.length > 500) {

                        event.preventDefault();

                        mensaje.text(
                            "El motivo no puede superar " +
                            "los 500 caracteres."
                        );

                        textarea.focus();

                        return;
                    }

                    // Confirmar antes de enviar.

                    var confirmar = window.confirm(
                        "¿Está seguro de que desea " +
                        "enviar esta justificación " +
                        "para revisión del docente?"
                    );

                    if (!confirmar) {

                        event.preventDefault();

                        return;
                    }

                    textarea.val(motivo);

                    // Evitar envíos repetidos.

                    boton.prop("disabled", true);

                    boton.text("Enviando justificación...");
                });

            // ========================================
            // LIMPIAR FORMULARIO
            // ========================================

            $(".justificacion-formulario").on(
                "reset",
                function () {

                    var formulario = $(this);

                    formulario
                        .find(".cantidad-caracteres")
                        .text("0");

                    formulario
                        .find(".mensaje-validacion")
                        .text("");

                    formulario
                        .find(".contador-caracteres")
                        .css("color", "#64748b");
                });
        });

    </script>
}