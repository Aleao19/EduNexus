@model EduNexus.Abstracciones.ModelosParaUI.Materias.AsignarMateriaDto

@{
    ViewBag.Title = "Asignar materia a sección";
}

<h2>Asignar materia a una sección</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="container">
            <div class="row">
                <div class="col-md-8 offset-md-1">

                    <div class="form-group mt-3">
                        @Html.LabelFor(model => model.id_materia, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.DropDownListFor(model => model.id_materia, (IEnumerable<SelectListItem>)ViewBag.Materias, "-- Seleccione una materia --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.id_materia, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group mt-3">
                        @Html.LabelFor(model => model.seccion, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.seccion, new { htmlAttributes = new { @class = "form-control", list = "listaSecciones", autocomplete = "off", placeholder = "Ej: Tercer Grado - 3-A (2026)" } })
                            <datalist id="listaSecciones">
                                @foreach (string etiqueta in (List<string>)ViewBag.EtiquetasSecciones)
                                {
                                    <option value="@etiqueta"></option>
                                }
                            </datalist>
                            @Html.ValidationMessageFor(model => model.seccion, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-offset-2 col-md-10 my-3">
                            <input type="submit" value="Asignar" class="btn btn-cyan" />
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Regresar", "ListadoDeAsignaciones")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}