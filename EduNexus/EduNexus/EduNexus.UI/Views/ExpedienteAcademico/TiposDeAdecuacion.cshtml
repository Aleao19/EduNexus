@model IEnumerable<EduNexus.Abstracciones.ModelosParaUI.ExpedienteAcademico.TipoAdecuacionDto>
@{
    ViewBag.Title = "Tipos de adecuación";
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Estudiantes</div>
            <h2 class="page-title">Tipos de adecuación</h2>
            <div class="page-subtitle">Categorías disponibles para clasificar los casos de adecuación.</div>
        </div>
        <div class="col-12 col-md-auto ms-auto">
            <div class="btn-list">
                @Html.ActionLink("Regresar", "Index", "Expedientes", null, new { @class = "btn btn-outline-secondary" })
                @Html.ActionLink("Nuevo tipo", "CrearTipoAdecuacion", null, new { @class = "btn btn-primary" })
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Listado de tipos</h3>
    </div>
    @if (!Model.Any())
    {
        <div class="empty">
            <p class="empty-title">No hay tipos de adecuación registrados</p>
            <p class="empty-subtitle text-secondary">Cree una categoría para poder clasificar los casos.</p>
            <div class="empty-action">
                @Html.ActionLink("Nuevo tipo", "CrearTipoAdecuacion", null, new { @class = "btn btn-primary" })
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.nombre)</th>
                        <th>@Html.DisplayNameFor(model => model.descripcion)</th>
                        <th>@Html.DisplayNameFor(model => model.casos_activos)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-medium">@item.nombre</td>
                            <td>@item.descripcion</td>
                            <td><span class="badge bg-blue-lt">@item.casos_activos</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
