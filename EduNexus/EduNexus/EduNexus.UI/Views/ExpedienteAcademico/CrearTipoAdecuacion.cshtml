@model EduNexus.Abstracciones.ModelosParaUI.ExpedienteAcademico.TipoAdecuacionDto
@{
    ViewBag.Title = "Nuevo tipo de adecuación";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-7">
        <h1 class="mb-4">Nuevo tipo de adecuación</h1>
        <div class="card shadow-sm">
            <div class="card-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.nombre, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.nombre, new { @class = "form-control", placeholder = "Ej: Adecuación de acceso" })
                        @Html.ValidationMessageFor(m => m.nombre, "", new { @class = "text-danger" })
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(m => m.descripcion, new { @class = "form-label" })
                        @Html.TextAreaFor(m => m.descripcion, 3, 60, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.descripcion, "", new { @class = "text-danger" })
                    </div>
                    <div class="form-footer d-flex justify-content-between">
                        @Html.ActionLink("Cancelar", "TiposDeAdecuacion", null, new { @class = "btn btn-outline-secondary" })
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
