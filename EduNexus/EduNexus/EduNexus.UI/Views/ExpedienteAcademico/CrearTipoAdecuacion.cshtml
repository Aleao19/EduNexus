@model EduNexus.Abstracciones.ModelosParaUI.ExpedienteAcademico.TipoAdecuacionDto
@{
    ViewBag.Title = "Nuevo tipo de adecuación";
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Estudiantes</div>
            <h2 class="page-title">Nuevo tipo de adecuación</h2>
            <div class="page-subtitle">Agregue una categoría para clasificar los casos de adecuación.</div>
        </div>
    </div>
</div>

<div class="card">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="card-header">
            <h3 class="card-title">Datos del tipo de adecuación</h3>
        </div>
        <div class="card-body">
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
            <div class="row g-3">
                <div class="col-md-6">
                    @Html.LabelFor(m => m.nombre, new { @class = "form-label required" })
                    @Html.TextBoxFor(m => m.nombre, new { @class = "form-control", placeholder = "Ej: Adecuación de acceso" })
                    @Html.ValidationMessageFor(m => m.nombre, "", new { @class = "text-danger" })
                </div>
                <div class="col-12">
                    @Html.LabelFor(m => m.descripcion, new { @class = "form-label" })
                    @Html.TextAreaFor(m => m.descripcion, 3, 60, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.descripcion, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="card-footer en-form-acciones">
            @Html.ActionLink("Cancelar", "TiposDeAdecuacion", null, new { @class = "btn btn-outline-secondary" })
            <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
