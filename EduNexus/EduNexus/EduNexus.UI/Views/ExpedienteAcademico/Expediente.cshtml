@model EduNexus.Abstracciones.ModelosParaUI.Expedientes.ExpedienteEstudianteDto
@using EduNexus.Abstracciones.ModelosParaUI.ExpedienteAcademico

@* Vista parcial: pestaña "Adecuaciones y ayudas" del expediente unificado (REXP-02-008 / REXP-02-009).
   La acción ExpedienteAcademico/Expediente ahora redirige a esa pestaña.
   Los enlaces indican el controlador porque la vista se pinta desde ExpedientesController. *@

@helper TablaCasos(List<CasoApoyoDto> casos, string accionClasificar, string accionFinalizar, string textoVacio)
{
    if (casos == null || !casos.Any())
    {
        <div class="card-body text-secondary text-center py-4">@textoVacio</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr><th>Tipo</th><th>Descripción del caso</th><th>Registro</th><th>Estado</th><th class="en-acciones">Acciones</th></tr>
                </thead>
                <tbody>
                    @foreach (var c in casos)
                    {
                        <tr>
                            <td>
                                @if (c.id_tipo.HasValue)
                                {
                                    <span class="badge bg-blue-lt">@c.tipo</span>
                                }
                                else
                                {
                                    <span class="badge bg-yellow-lt">Sin clasificar</span>
                                }
                            </td>
                            <td>@c.descripcion</td>
                            <td class="text-nowrap">@c.fecha_registro.ToString("dd/MM/yyyy")</td>
                            <td><span class="badge bg-@(c.estado == "Activa" ? "green" : "secondary")-lt">@c.estado</span></td>
                            <td class="en-acciones">
                                @if (c.estado == "Activa")
                                {
                                    @Html.ActionLink(c.id_tipo.HasValue ? "Reclasificar" : "Clasificar", accionClasificar, "ExpedienteAcademico", new { id = c.id_caso }, new { @class = "btn btn-sm btn-outline-primary" })
                                    using (Html.BeginForm(accionFinalizar, "ExpedienteAcademico", new { id = c.id_caso }, FormMethod.Post, new { style = "display:inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Marcar este caso como finalizado?');">Finalizar</button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

<div class="d-flex justify-content-end mb-3">
    @Html.ActionLink("Tipos de adecuación", "TiposDeAdecuacion", "ExpedienteAcademico", null, new { @class = "btn btn-sm btn-outline-secondary" })
</div>

<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title">Adecuaciones</h3>
        <div class="card-actions">
            @Html.ActionLink("Registrar adecuación", "RegistrarAdecuacion", "ExpedienteAcademico", new { id = Model.estudiante.id_usuario }, new { @class = "btn btn-sm btn-primary" })
        </div>
    </div>
    @TablaCasos(Model.adecuaciones, "ClasificarAdecuacion", "FinalizarAdecuacion", "El estudiante no tiene adecuaciones registradas.")
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Ayudas y beneficios</h3>
        <div class="card-actions">
            @Html.ActionLink("Registrar ayuda", "RegistrarAyuda", "ExpedienteAcademico", new { id = Model.estudiante.id_usuario }, new { @class = "btn btn-sm btn-primary" })
        </div>
    </div>
    @TablaCasos(Model.ayudas, "ClasificarAyuda", "FinalizarAyuda", "El estudiante no tiene ayudas registradas.")
</div>
