@model EduNexus.Abstracciones.ModelosParaUI.Expedientes.ExpedienteEstudianteDto

@* Vista parcial: pestaña "Historial académico" del expediente unificado (REXP-02-007).
   La acción ExpedienteAcademico/HistorialAcademico ahora redirige a esa pestaña. *@
@{
    var anios = Model.anios ?? new List<int>();
    int? anioSeleccionado = Model.anio_seleccionado;
}

@if (Model.sin_historial)
{
    <div class="card">
        <div class="empty">
            <div class="empty-icon">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 8l0 4l2 2" /><path d="M3.05 11a9 9 0 1 1 .5 4m-.5 5v-5h5" /></svg>
            </div>
            <p class="empty-title">No hay historial académico disponible</p>
            <p class="empty-subtitle text-secondary">El estudiante no cuenta con registros académicos de años lectivos anteriores.</p>
        </div>
    </div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            @using (Html.BeginForm("Expediente", "Expedientes", new { id = Model.estudiante.id_usuario }, FormMethod.Get))
            {
                <input type="hidden" name="tab" value="historial" />
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label" for="anio">Año lectivo</label>
                        <select class="form-select" id="anio" name="anio">
                            <option value="">Todos los años</option>
                            @foreach (var a in anios)
                            {
                                <option value="@a" @(anioSeleccionado == a ? "selected" : "")>@(a > 0 ? a.ToString() : "Sin año")</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-auto">
                        <div class="btn-list">
                            @Html.ActionLink("Ver todo", "Expediente", "Expedientes", new { id = Model.estudiante.id_usuario, tab = "historial" }, new { @class = "btn btn-outline-secondary" })
                            <input type="submit" value="Filtrar" class="btn btn-primary" />
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    if (!Model.historial.Any())
    {
        <div class="card">
            <div class="card-body text-secondary text-center py-4">No hay registros para el año lectivo seleccionado.</div>
        </div>
    }

    foreach (var anio in Model.historial)
    {
        <div class="card mb-3">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h3 class="card-title">@(anio.anio > 0 ? anio.anio.ToString() : "Sin año") · @anio.grado @anio.seccion</h3>
                <span class="text-secondary">
                    @anio.periodo
                    @if (anio.promedio.HasValue)
                    {
                        <span class="badge bg-blue-lt ms-2">@(anio.promedio_ponderado ? "Promedio ponderado" : "Promedio"): @anio.promedio.Value.ToString("0.00")</span>
                    }
                </span>
            </div>
            @if (!anio.calificaciones.Any())
            {
                <div class="card-body text-secondary text-center py-4">Sin calificaciones registradas para este año lectivo.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr><th>Materia</th><th>Evaluación</th><th>Porcentaje</th><th>Calificación</th><th>Estado</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var c in anio.calificaciones)
                            {
                                <tr>
                                    <td class="fw-medium">@c.materia</td>
                                    <td>@c.evaluacion</td>
                                    <td>@c.porcentaje.ToString("0.##")%</td>
                                    <td>@c.calificacion.ToString("0.##")</td>
                                    <td>@c.estado</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
}
