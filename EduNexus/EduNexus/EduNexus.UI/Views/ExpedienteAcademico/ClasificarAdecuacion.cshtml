@model EduNexus.Abstracciones.ModelosParaUI.ExpedienteAcademico.CasoApoyoDto
@{
    ViewBag.Title = "Clasificar adecuación";
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Estudiantes</div>
            <h2 class="page-title">Clasificar adecuación</h2>
            <div class="page-subtitle">Estudiante: <strong>@Model.estudiante</strong></div>
        </div>
    </div>
</div>

<div class="card mb-3">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="card-header">
            <h3 class="card-title">Clasificación del caso</h3>
        </div>
        <div class="card-body">
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
            <div class="row g-3">
                <div class="col-12">
                    <div class="en-dato-label">Descripción del caso</div>
                    <div class="en-dato-valor">@Model.descripcion</div>
                </div>
                <div class="col-md-6">
                    <div class="en-dato-label">Clasificación actual</div>
                    <div><span class="badge bg-@(Model.id_tipo.HasValue ? "blue" : "yellow")-lt">@Model.tipo</span></div>
                </div>
                <div class="col-md-6">
                    <label class="form-label required" for="id_tipo">Tipo de adecuación</label>
                    @Html.DropDownListFor(m => m.id_tipo, (SelectList)ViewBag.Tipos, "Seleccione una categoría", new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.id_tipo, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="card-footer en-form-acciones">
            @Html.ActionLink("Cancelar", "Expediente", "Expedientes", new { id = Model.id_usuario, tab = "apoyos" }, new { @class = "btn btn-outline-secondary" })
            <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
