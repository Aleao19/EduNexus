@model EduNexus.UI.Controllers.CrearAsignacionVm
@{
    ViewBag.Title = "Nueva asignación";
}

<div class="row align-items-center mb-3">
    <div class="col">
        <div class="text-secondary small mb-1">
            @Html.ActionLink("Aula Virtual", "AulaVirtual", "AulaVirtual") /
            <a href="@Url.Action("Materia", "AulaVirtual", new { id = Model.idMateria, seccion = Model.idSeccion })">Materia</a> / Nueva asignación
        </div>
        <h1 class="mb-0">Nueva asignación</h1>
        <p class="text-secondary mb-0">@Model.nombreMateria — @Model.etiquetaSeccion</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                @using (Html.BeginForm("CrearAsignacion", "Asignaciones", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.idMateria)
                    @Html.HiddenFor(m => m.idSeccion)

                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                    <div class="mb-3">
                        <label class="form-label required" for="nombre">Nombre</label>
                        <input type="text" class="form-control" id="nombre" name="nombre" maxlength="256" value="@Model.nombre" />
                        @Html.ValidationMessage("nombre", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="descripcion">Descripción</label>
                        <textarea class="form-control" id="descripcion" name="descripcion" rows="4" maxlength="512">@Model.descripcion</textarea>
                        @Html.ValidationMessage("descripcion", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label required" for="porcentaje">Porcentaje de la nota (%)</label>
                        <input type="text" inputmode="decimal" class="form-control" id="porcentaje" name="porcentaje" value="@Model.porcentaje" />
                        <div class="form-text">Disponible en esta materia: @Model.porcentajeDisponible.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) %</div>
                        @Html.ValidationMessage("porcentaje", new { @class = "text-danger small" })
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label required" for="fechaApertura">Fecha de apertura</label>
                            <input type="datetime-local" class="form-control" id="fechaApertura" name="fechaApertura" value="@Model.fechaApertura" />
                            @Html.ValidationMessage("fechaApertura", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label required" for="fechaCierre">Fecha de cierre</label>
                            <input type="datetime-local" class="form-control" id="fechaCierre" name="fechaCierre" value="@Model.fechaCierre" />
                            @Html.ValidationMessage("fechaCierre", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="text-secondary small mb-3">
                        La asignación se publicará para @Model.cantidadEstudiantes estudiantes de la sección.
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="@Url.Action("Materia", "AulaVirtual", new { id = Model.idMateria, seccion = Model.idSeccion })"
                           class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">Crear asignación</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>