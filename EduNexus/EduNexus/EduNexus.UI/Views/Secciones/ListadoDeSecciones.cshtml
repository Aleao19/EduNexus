@model IEnumerable<EduNexus.Abstracciones.ModelosParaUI.Secciones.SeccionesDto>

@{
    ViewBag.Title = "Listado de secciones";
    int total = Model.Count();
    int cupoTotal = Model.Sum(x => x.cupo);
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Académico</div>
            <h2 class="page-title">Secciones</h2>
            <div class="page-subtitle">Gestión de secciones académicas por grado.</div>
        </div>
        <div class="col-12 col-md-auto ms-auto">
            <div class="btn-list">
                @Html.ActionLink("Grados", "ListadoDeGrados", "Grados", null, new { @class = "btn btn-outline-secondary" })
                @Html.ActionLink("Cupos por grupo", "CuposPorGrupo", null, new { @class = "btn btn-outline-secondary" })
                @Html.ActionLink("Nueva sección", "CrearSeccion", null, new { @class = "btn btn-primary" })
            </div>
        </div>
    </div>
</div>

<div class="row row-cards g-3 mb-3">
    <div class="col-sm-4">
        <div class="card card-sm">
            <div class="card-body">
                <div class="text-secondary small">Secciones activas</div>
                <div class="h2 mb-0">@total</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card card-sm">
            <div class="card-body">
                <div class="text-secondary small">Cupo total</div>
                <div class="h2 mb-0">@cupoTotal</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card card-sm">
            <div class="card-body">
                <div class="text-secondary small">Año lectivo</div>
                <div class="h2 mb-0">@DateTime.Now.Year</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Listado de secciones</h3>
    </div>

    @if (!Model.Any())
    {
        <div class="empty">
            <div class="empty-icon">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M5 4h4l3 3h7a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10a2 2 0 0 1 2 -2" /></svg>
            </div>
            <p class="empty-title">No hay secciones registradas</p>
            <p class="empty-subtitle text-secondary">Cree una sección para poder asignarle estudiantes y horario.</p>
            <div class="empty-action">
                @Html.ActionLink("Nueva sección", "CrearSeccion", null, new { @class = "btn btn-primary" })
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vcenter card-table" id="myTable">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.nombre)</th>
                        <th>Año</th>
                        <th>@Html.DisplayNameFor(model => model.grado)</th>
                        <th>@Html.DisplayNameFor(model => model.cupo)</th>
                        <th>Estudiantes</th>
                        <th class="en-acciones">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-blue-lt">@item.nombre</span>
                            </td>
                            <td>@Html.DisplayFor(modelItem => item.anio)</td>
                            <td>@Html.DisplayFor(modelItem => item.nombre_grado)</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <span class="me-2">@item.cupo</span>
                                    <div class="progress progress-sm flex-fill" style="max-width:80px">
                                        <div class="progress-bar" style="width: @(item.cupo > 0 ? Math.Min(100, item.estudiantes_matriculados * 100 / item.cupo) : 0)%" role="progressbar"></div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @item.estudiantes_matriculados / @item.cupo
                            </td>
                            <td class="en-acciones">
                                <div class="btn-list">
                                    @Html.ActionLink("Asignar estudiantes", "AsignarEstudiantes", new { id = item.id_seccion }, new { @class = "btn btn-sm btn-outline-success" })
                                    @Html.ActionLink("Detalles", "DetalleDeSeccion", new { id = item.id_seccion }, new { @class = "btn btn-sm btn-outline-primary" })
                                    @Html.ActionLink("Editar", "EditarSeccion", new { id = item.id_seccion }, new { @class = "btn btn-sm btn-outline-secondary" })
                                    @Html.ActionLink("Eliminar", "EliminarSeccion", new { id = item.id_seccion }, new { @class = "btn btn-sm btn-outline-danger" })
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section scripts
{
    <script src="~/Scripts/General/General.js"></script>
}
