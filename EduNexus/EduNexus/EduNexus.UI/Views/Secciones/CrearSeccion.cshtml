@model EduNexus.Abstracciones.ModelosParaUI.Secciones.SeccionesDto

@{
    ViewBag.Title = "Crear sección";
    var grados = ViewBag.Grados as List<EduNexus.Abstracciones.ModelosParaUI.Grados.GradosDto>;
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Académico</div>
            <h2 class="page-title">Crear nueva sección</h2>
            <div class="page-subtitle">Registre una sección de un grado para el año lectivo indicado.</div>
        </div>
    </div>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Datos de la sección</h3>
        </div>
        <div class="card-body">

            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

            <div class="row g-3">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.nombre_grado, htmlAttributes: new { @class = "form-label required" })
                    @Html.EditorFor(model => model.nombre_grado, new { htmlAttributes = new { @class = "form-control", list = "listaGrados", placeholder = "Ej: Primer Grado", autocomplete = "off" } })
                    <datalist id="listaGrados">
                        @if (grados != null)
                        {
                            foreach (var g in grados)
                            {
                                <option value="@g.descripcion"></option>
                            }
                        }
                    </datalist>
                    <small class="form-hint">Escriba o elija uno de los grados registrados.</small>
                    @Html.ValidationMessageFor(model => model.nombre_grado, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(model => model.nombre, htmlAttributes: new { @class = "form-label required" })
                    @Html.EditorFor(model => model.nombre, new { htmlAttributes = new { @class = "form-control", placeholder = "Ej: 1-A" } })
                    @Html.ValidationMessageFor(model => model.nombre, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(model => model.anio, htmlAttributes: new { @class = "form-label required" })
                    @Html.EditorFor(model => model.anio, new { htmlAttributes = new { @class = "form-control", placeholder = "Ej: 2026" } })
                    @Html.ValidationMessageFor(model => model.anio, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(model => model.cupo, htmlAttributes: new { @class = "form-label required" })
                    @Html.EditorFor(model => model.cupo, new { htmlAttributes = new { @class = "form-control" } })
                    <small class="form-hint">Cantidad máxima de estudiantes de la sección.</small>
                    @Html.ValidationMessageFor(model => model.cupo, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="card-footer en-form-acciones">
            @Html.ActionLink("Cancelar", "ListadoDeSecciones", null, new { @class = "btn btn-outline-secondary" })
            <input type="submit" value="Guardar" class="btn btn-primary" />
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
