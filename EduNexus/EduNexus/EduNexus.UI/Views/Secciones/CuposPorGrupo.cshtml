@model IEnumerable<EduNexus.Abstracciones.ModelosParaUI.Secciones.SeccionesDto>

@{
    ViewBag.Title = "Cupos por grupo";
    var grados = ViewBag.Grados as List<EduNexus.Abstracciones.ModelosParaUI.Grados.GradosDto>;
    var anios = ViewBag.Anios as List<int>;
    int? gradoSeleccionado = ViewBag.GradoSeleccionado as int?;
    int? anioSeleccionado = ViewBag.AnioSeleccionado as int?;
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Académico</div>
            <h2 class="page-title">Cupos por grupo</h2>
            <div class="page-subtitle">Cantidad de estudiantes asignados y cupos disponibles por grupo.</div>
        </div>
        <div class="col-12 col-md-auto ms-auto">
            <div class="btn-list">
                @Html.ActionLink("Regresar a secciones", "ListadoDeSecciones", null, new { @class = "btn btn-outline-secondary" })
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title">Filtros</h3>
    </div>
    <div class="card-body">
        @using (Html.BeginForm("CuposPorGrupo", "Secciones", FormMethod.Get))
        {
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label" for="grado">Nivel educativo</label>
                    <select class="form-select" id="grado" name="grado">
                        <option value="">Todos</option>
                        @if (grados != null)
                        {
                            foreach (var g in grados)
                            {
                                <option value="@g.id_grado" @(gradoSeleccionado == g.id_grado ? "selected" : "")>@g.descripcion</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="anio">Periodo lectivo</label>
                    <select class="form-select" id="anio" name="anio">
                        <option value="">Todos</option>
                        @if (anios != null)
                        {
                            foreach (var a in anios)
                            {
                                <option value="@a" @(anioSeleccionado == a ? "selected" : "")>@a</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <div class="btn-list justify-content-md-end">
                        @Html.ActionLink("Limpiar", "CuposPorGrupo", null, new { @class = "btn btn-outline-secondary" })
                        <input type="submit" value="Filtrar" class="btn btn-primary" />
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Grupos</h3>
    </div>

    @if (!Model.Any())
    {
        <div class="empty">
            <div class="empty-icon">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" /><path d="M21 21l-6 -6" /></svg>
            </div>
            <p class="empty-title">No hay grupos que coincidan con el filtro</p>
            <p class="empty-subtitle text-secondary">Pruebe con otro nivel educativo o periodo lectivo.</p>
            <div class="empty-action">
                @Html.ActionLink("Limpiar filtros", "CuposPorGrupo", null, new { @class = "btn btn-outline-secondary" })
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vcenter card-table" id="myTable" data-order="[]">
                <thead>
                    <tr>
                        <th>Grupo</th>
                        <th>@Html.DisplayNameFor(model => model.grado)</th>
                        <th>@Html.DisplayNameFor(model => model.anio)</th>
                        <th>@Html.DisplayNameFor(model => model.cupo)</th>
                        <th>Estudiantes asignados</th>
                        <th>@Html.DisplayNameFor(model => model.cupos_disponibles)</th>
                        <th title="Estudiantes asignados por género">Femenino</th>
                        <th>Masculino</th>
                        <th>Otro</th>
                        <th title="Estudiantes con adecuación o discapacidad">Con necesidades</th>
                        <th class="en-acciones">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-blue-lt">@item.nombre</span></td>
                            <td>@Html.DisplayFor(modelItem => item.nombre_grado)</td>
                            <td>@Html.DisplayFor(modelItem => item.anio)</td>
                            <td>@Html.DisplayFor(modelItem => item.cupo)</td>
                            <td>@Html.DisplayFor(modelItem => item.estudiantes_matriculados)</td>
                            <td>
                                <span class="badge @(item.cupos_disponibles > 0 ? "bg-green-lt" : "bg-red-lt")">@Html.DisplayFor(modelItem => item.cupos_disponibles)</span>
                            </td>
                            <td>@item.estudiantes_femenino</td>
                            <td>@item.estudiantes_masculino</td>
                            <td>
                                @item.estudiantes_otro
                                @if (item.estudiantes_sin_genero > 0)
                                {
                                    <span class="text-secondary small" title="Sin género registrado">(+@item.estudiantes_sin_genero sin dato)</span>
                                }
                            </td>
                            <td>@item.estudiantes_con_necesidades</td>
                            <td class="en-acciones">
                                @Html.ActionLink("Consultar", "DetalleDeSeccion", new { id = item.id_seccion }, new { @class = "btn btn-sm btn-outline-primary" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section scripts
{
    <script src="~/Scripts/General/General.js"></script>
}
