@model EduNexus.Abstracciones.ModelosParaUI.Secciones.SeccionesDto

@{
    ViewBag.Title = "Asignar estudiantes";
    var estudiantesAsignados = (List<EduNexus.Abstracciones.ModelosParaUI.Secciones.EstudianteSeccionVm>)ViewBag.EstudiantesAsignados;
    var destinos = (List<EduNexus.Abstracciones.ModelosParaUI.Secciones.SeccionDestinoVm>)ViewBag.SeccionesDestino?? new List<EduNexus.Abstracciones.ModelosParaUI.Secciones.SeccionDestinoVm>();
    int cantidadAsignada = ViewBag.CantidadAsignada ?? 0;
    int cupoMaximo = ViewBag.CupoMaximo ?? 0;
    int cuposDisponibles = cupoMaximo - cantidadAsignada;
}

<div class="row align-items-center mb-3">
    <div class="col-auto">
        @{
            var usuarioActual = Session[EduNexus.UI.Models.AutorizarAdministradorAttribute.ClaveSesion]
                as EduNexus.Abstracciones.ModelosParaUI.Usuarios.UsuarioDto;
            bool esAdminActual = EduNexus.UI.Models.RolesSistema.Es(usuarioActual, EduNexus.UI.Models.RolesSistema.Administrador);
        }

        @if (esAdminActual)
        {
            @Html.ActionLink("Volver a secciones", "ListadoDeSecciones", null,
                new { @class = "btn btn-outline-secondary" })
        }
        else
        {
            @Html.ActionLink("Volver al horario", "HorarioParaAsignacion", "Horarios",
                new { id = Model.id_seccion }, new { @class = "btn btn-outline-secondary" })
        }
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-header">
        <h3 class="card-title mb-0">Información de la sección</h3>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="text-secondary small">Sección</div>
                <div class="fw-bold">@Model.nombre</div>
            </div>
            <div class="col-md-6">
                <div class="text-secondary small">Grado</div>
                <div class="fw-bold">@Model.nombre_grado</div>
            </div>
            <div class="col-md-4">
                <div class="text-secondary small">Año lectivo</div>
                <div class="fw-bold">@(Model.anio.HasValue ? Model.anio.Value.ToString() : "No disponible")</div>
            </div>
            <div class="col-md-4">
                <div class="text-secondary small">Estudiantes asignados</div>
                <div class="h3 mb-0">@cantidadAsignada</div>
            </div>
            <div class="col-md-4">
                <div class="text-secondary small">Cupos disponibles</div>
                <div class="h3 mb-0">@cuposDisponibles</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-header">
        <h3 class="card-title mb-0">Agregar estudiante</h3>
    </div>
    <div class="card-body">
        @if (ViewBag.ErrorRolEstudiante == true)
        {
            <div class="alert alert-warning">
                No se encontró el rol Estudiante. Verifica el nombre del rol registrado.
            </div>
        }
        else if (cuposDisponibles <= 0)
        {
            <div class="alert alert-warning">
                Esta sección ya alcanzó su cupo máximo.
            </div>
        }
        else
        {
            using (Html.BeginForm("AsignarEstudiantes", "Secciones", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.Hidden("id", Model.id_seccion)

                <div class="mb-3">
                    @Html.Label("idUsuario", "Selecciona un estudiante",
                        new { @class = "form-label" })

                    @Html.DropDownList(
                        "idUsuario",
                        (SelectList)ViewBag.EstudiantesDisponibles,
                        "-- Seleccione un estudiante --",
                        new { @class = "form-select", required = "required" })
                </div>

                <button type="submit" class="btn btn-primary">
                    Asignar estudiante
                </button>
            }
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header">
        <h3 class="card-title mb-0">Estudiantes de esta sección</h3>
    </div>

    @if (cantidadAsignada == 0)
    {
        <div class="card-body">
            <p class="text-secondary mb-0">
                Todavía no hay estudiantes asignados a esta sección.
            </p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>Nombre completo</th>
                        <th>Identificación</th>
                        <th>Fecha de asignación</th>
                        <th>Mover a otra sección</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var estudiante in estudiantesAsignados)
                    {
                        <tr>
                            <td>@estudiante.nombreCompleto</td>
                            <td>@estudiante.identificacion</td>
                            <td>@(((DateTime)estudiante.fecha_asignacion).ToString("dd/MM/yyyy"))</td>
                            <td>
                                @if (!destinos.Any())
                                {
                                    <span class="text-secondary small">No hay otras secciones del mismo grado y año.</span>
                                }
                                else
                                {
                                    using (Html.BeginForm("MoverEstudiante", "Secciones", FormMethod.Post, new { @class = "d-flex gap-2 align-items-center", onsubmit = "return confirm('¿Desea mover a este estudiante a la sección seleccionada?');" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.id_seccion" />
                                        <input type="hidden" name="idUsuario" value="@estudiante.id_usuario" />
                                        <select name="idSeccionDestino" class="form-select form-select-sm" required aria-label="Sección destino">
                                            <option value="">-- Sección destino --</option>
                                            @foreach (var d in destinos)
                                            {
                                                <option value="@d.id_seccion" disabled="@(d.disponibles <= 0)">@d.texto (@d.disponibles cupo(s))</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Mover</button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>