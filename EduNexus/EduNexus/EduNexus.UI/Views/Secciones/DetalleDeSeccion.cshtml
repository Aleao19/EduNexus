@model EduNexus.Abstracciones.ModelosParaUI.Secciones.SeccionesDto

@{
    ViewBag.Title = "Detalle de la sección";
}

<h2>Detalle de la sección</h2>

<div>
    <hr />
    <div class="container my-2">
        <div class="row">
            <div class="col-md-8 offset-md-1">
                <div class="form-group">
                    <dl class="dl-horizontal">

                        <dt>
                            @Html.DisplayNameFor(model => model.nombre)
                        </dt>

                        <dd>
                            @Html.DisplayFor(model => model.nombre)
                        </dd>

                        <dt>
                            @Html.DisplayNameFor(model => model.anio)
                        </dt>

                        <dd>
                            @Html.DisplayFor(model => model.anio)
                        </dd>

                        <dt>
                            @Html.DisplayNameFor(model => model.grado)
                        </dt>

                        <dd>
                            @Html.DisplayFor(model => model.nombre_grado)
                        </dd>

                        <dt>
                            @Html.DisplayNameFor(model => model.cupo)
                        </dt>

                        <dd>
                            @Html.DisplayFor(model => model.cupo)
                        </dd>

                        <dt>
                            Estudiantes asignados
                        </dt>

                        <dd>
                            @Html.DisplayFor(model => model.estudiantes_matriculados)
                        </dd>

                        <dt>
                            @Html.DisplayNameFor(model => model.cupos_disponibles)
                        </dt>

                        <dd>
                            @Html.DisplayFor(model => model.cupos_disponibles)
                        </dd>

                        @if (Model.fecha_modificacion != null)
                        {
                            <dt>
                                @Html.DisplayNameFor(model => model.fecha_modificacion)
                            </dt>

                            <dd>
                                @Model.fecha_modificacion.Value.ToString("dd/MM/yyyy hh:mm tt")
                            </dd>

                            <dt>
                                @Html.DisplayNameFor(model => model.usuario_modificacion)
                            </dt>

                            <dd>
                                @Html.DisplayFor(model => model.usuario_modificacion)
                            </dd>
                        }

                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>
<p>
    @Html.ActionLink("Editar", "EditarSeccion", new { id = Model.id_seccion }) |
    @Html.ActionLink("Regresar", "ListadoDeSecciones")
</p>
