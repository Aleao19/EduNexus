@model EduNexus.Abstracciones.ModelosParaUI.Secciones.SeccionesDto

@{
    ViewBag.Title = "Detalle de la sección";
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Académico</div>
            <h2 class="page-title">Detalle de la sección</h2>
            <div class="page-subtitle">Cupo, estudiantes asignados y distribución de la sección.</div>
        </div>
        <div class="col-12 col-md-auto ms-auto">
            <div class="btn-list">
                @Html.ActionLink("Regresar", "ListadoDeSecciones", null, new { @class = "btn btn-outline-secondary" })
                @Html.ActionLink("Editar", "EditarSeccion", new { id = Model.id_seccion }, new { @class = "btn btn-primary" })
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Datos de la sección</h3>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-sm-6 col-md-4">
                <div class="en-dato-label">@Html.DisplayNameFor(model => model.nombre)</div>
                <div class="en-dato-valor"><span class="badge bg-blue-lt">@Html.DisplayFor(model => model.nombre)</span></div>
            </div>
            <div class="col-sm-6 col-md-4">
                <div class="en-dato-label">@Html.DisplayNameFor(model => model.anio)</div>
                <div class="en-dato-valor">@Html.DisplayFor(model => model.anio)</div>
            </div>
            <div class="col-sm-6 col-md-4">
                <div class="en-dato-label">@Html.DisplayNameFor(model => model.grado)</div>
                <div class="en-dato-valor">@Html.DisplayFor(model => model.nombre_grado)</div>
            </div>
            <div class="col-sm-6 col-md-4">
                <div class="en-dato-label">@Html.DisplayNameFor(model => model.cupo)</div>
                <div class="en-dato-valor">@Html.DisplayFor(model => model.cupo)</div>
            </div>
            <div class="col-sm-6 col-md-4">
                <div class="en-dato-label">Estudiantes asignados</div>
                <div class="en-dato-valor">@Html.DisplayFor(model => model.estudiantes_matriculados)</div>
            </div>
            <div class="col-sm-6 col-md-4">
                <div class="en-dato-label">@Html.DisplayNameFor(model => model.cupos_disponibles)</div>
                <div class="en-dato-valor">@Html.DisplayFor(model => model.cupos_disponibles)</div>
            </div>
            <div class="col-sm-6 col-md-4">
                <div class="en-dato-label">Distribución por género</div>
                <div class="en-dato-valor">
                    Femenino: @Model.estudiantes_femenino ·
                    Masculino: @Model.estudiantes_masculino ·
                    Otro: @Model.estudiantes_otro
                    @if (Model.estudiantes_sin_genero > 0)
                    {
                        <span class="text-secondary">· Sin dato: @Model.estudiantes_sin_genero</span>
                    }
                </div>
            </div>
            <div class="col-sm-6 col-md-4">
                <div class="en-dato-label">Estudiantes con necesidades</div>
                <div class="en-dato-valor">
                    @Model.estudiantes_con_necesidades
                    <span class="text-secondary small">(adecuación o discapacidad)</span>
                </div>
            </div>
        </div>
    </div>
    @if (Model.fecha_modificacion != null)
    {
        <div class="card-footer text-secondary small">
            @Html.DisplayNameFor(model => model.fecha_modificacion):
            @Model.fecha_modificacion.Value.ToString("dd/MM/yyyy hh:mm tt")
            · @Html.DisplayNameFor(model => model.usuario_modificacion):
            @Html.DisplayFor(model => model.usuario_modificacion)
        </div>
    }
</div>
