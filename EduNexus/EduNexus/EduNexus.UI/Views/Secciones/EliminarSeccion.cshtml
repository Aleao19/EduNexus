@model EduNexus.Abstracciones.ModelosParaUI.Secciones.SeccionesDto

@{
    ViewBag.Title = "Eliminar sección";
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Académico</div>
            <h2 class="page-title">Eliminar sección</h2>
            <div class="page-subtitle">Revise la información antes de confirmar la eliminación.</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">¿Está seguro de que desea eliminar esta sección?</h3>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-sm-6 col-md-3">
                <div class="en-dato-label">@Html.DisplayNameFor(model => model.nombre)</div>
                <div class="en-dato-valor">@Html.DisplayFor(model => model.nombre)</div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="en-dato-label">@Html.DisplayNameFor(model => model.anio)</div>
                <div class="en-dato-valor">@Html.DisplayFor(model => model.anio)</div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="en-dato-label">@Html.DisplayNameFor(model => model.grado)</div>
                <div class="en-dato-valor">@Html.DisplayFor(model => model.nombre_grado)</div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="en-dato-label">@Html.DisplayNameFor(model => model.estudiantes_matriculados)</div>
                <div class="en-dato-valor">@Html.DisplayFor(model => model.estudiantes_matriculados)</div>
            </div>
        </div>
    </div>
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.id_seccion)

        <div class="card-footer en-form-acciones">
            @Html.ActionLink("Cancelar", "ListadoDeSecciones", null, new { @class = "btn btn-outline-secondary" })
            <input type="submit" value="Eliminar" class="btn btn-danger" />
        </div>
    }
</div>
