@model EduNexus.Abstracciones.ModelosParaUI.Secciones.SeccionesDto

@{
    ViewBag.Title = "Eliminar sección";
}

<h2>Eliminar sección</h2>

<h4>¿Está seguro que desea eliminar esta sección?</h4>
<div>
    <hr />
    <div class="container my-2">
        <div class="row">
            <div class="col-md-8 offset-md-1">
                <div class="form-group">
                    <dl class="dl-horizontal">
                        <dt>
                            @Html.DisplayNameFor(model => model.nombre)
                        </dt>

                        <dd>
                            @Html.DisplayFor(model => model.nombre)
                        </dd>

                        <dt>
                            @Html.DisplayNameFor(model => model.anio)
                        </dt>

                        <dd>
                            @Html.DisplayFor(model => model.anio)
                        </dd>

                        <dt>
                            @Html.DisplayNameFor(model => model.grado)
                        </dt>

                        <dd>
                            @Html.DisplayFor(model => model.nombre_grado)
                        </dd>

                        <dt>
                            @Html.DisplayNameFor(model => model.estudiantes_matriculados)
                        </dt>

                        <dd>
                            @Html.DisplayFor(model => model.estudiantes_matriculados)
                        </dd>
                    </dl>
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.id_seccion)

                    <div class="form-group my-3">
                        <input type="submit" value="Eliminar" class="btn btn-danger" />
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<div>
    @Html.ActionLink("Regresar", "ListadoDeSecciones")
</div>
