@model EduNexus.UI.Models.ResetPasswordModel

@{
    ViewBag.Title = "Cambiar contraseña";
}

<h2>Cambiar contraseña</h2>

@if (ViewBag.Message != null)
{
    <div class="alert alert-success">
        @ViewBag.Message
    </div>
}

<div class="row">
    <div class="col-md-4 offset-md-4">
        @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { role = "form" }))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary("", new { @class = "text-danger" })

            <div class="form-group">
                @Html.LabelFor(m => m.NuevaContrasenna)
                @Html.PasswordFor(m => m.NuevaContrasenna, new { @class = "form-control", placeholder = "Nueva contraseña" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.ConfirmarContrasenna)
                @Html.PasswordFor(m => m.ConfirmarContrasenna, new { @class = "form-control", placeholder = "Confirmar nueva contraseña" })
            </div>

            @Html.HiddenFor(m => m.Token)

            <button type="submit" class="btn btn-primary">Cambiar contraseña</button>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
