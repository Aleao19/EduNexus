
@model EduNexus.Abstracciones.ModelosParaUI.Expedientes.ExpedienteDto

@{
    ViewBag.Title = "Detalle de Expediente";
}

<h2>Detalle de Expediente Estudiantil</h2>

<hr />

<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">
            Información personal del estudiante
        </h3>
    </div>

    <div class="panel-body">
        <dl class="dl-horizontal">

            <dt>Número de expediente</dt>
            <dd>@Model.id_expediente</dd>

            <dt>Número de matrícula</dt>
            <dd>@Model.id_matricula</dd>

            <dt>Identificación</dt>
            <dd>@Model.identificacion</dd>

            <dt>Nombre</dt>
            <dd>@Model.nombre</dd>

            <dt>Primer apellido</dt>
            <dd>@Model.apellido1</dd>

            <dt>Segundo apellido</dt>
            <dd>@Model.apellido2</dd>

            <dt>Sexo</dt>
            <dd>@Model.genero</dd>

            <dt>Grado</dt>
            <dd>@Model.grado</dd>

            <dt>Fecha de nacimiento</dt>
            <dd>@Model.fecha_nacimiento.ToString("dd/MM/yyyy")</dd>

            <dt>Teléfono</dt>
            <dd>@Model.telefono</dd>

            <dt>Correo electrónico</dt>
            <dd>@Model.correo</dd>

            <dt>Dirección</dt>
            <dd>@Model.direccion</dd>

        </dl>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">
            Información médica
        </h3>
    </div>

    <div class="panel-body">
        <dl class="dl-horizontal">

            <dt>Grupo sanguíneo</dt>
            <dd>@Model.grupo_sanguineo</dd>

            <dt>Alergias</dt>
            <dd>@Model.alergias</dd>

            <dt>¿Tiene discapacidad?</dt>
            <dd>
                @(Model.tiene_discapacidad ? "Sí" : "No")
            </dd>

            <dt>¿Tiene adecuación?</dt>
            <dd>
                @(Model.tiene_adecuacion ? "Sí" : "No")
            </dd>

        </dl>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">
            Contacto de emergencia
        </h3>
    </div>

    <div class="panel-body">
        <dl class="dl-horizontal">

            <dt>Contacto de emergencia</dt>
            <dd>@Model.contactoEmergencia</dd>

        </dl>
    </div>
</div>

<div class="my-3">

    @* =========================================
       REXP-03-006
       BOTÓN PARA EDITAR EXPEDIENTE
       ========================================= *@

    @Html.ActionLink(
        "Editar expediente",
        "EditarExpediente",
        "Expedientes",
        new { id = Model.id_expediente },
        new { @class = "btn btn-warning" }
    )

    @Html.ActionLink(
        "Adjuntar documento",
        "AdjuntarDocumento",
        "DocumentosExpediente",
        new { id_expediente = Model.id_expediente },
        new { @class = "btn btn-cyan" }
    )

    @Html.ActionLink(
        "Ver documentos",
        "HistorialDocumentos",
        "DocumentosExpediente",
        new { id_expediente = Model.id_expediente },
        new { @class = "btn btn-info" }
    )

    @Html.ActionLink(
        "Regresar al listado",
        "ListadoDeExpedientes",
        "Expedientes",
        null,
        new { @class = "btn btn-default" }
    )

</div>
