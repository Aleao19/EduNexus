@model IEnumerable<EduNexus.Abstracciones.ModelosParaUI.Expedientes.ExpedienteDto>

@{
    ViewBag.Title = "Listado de expedientes";
    int total = Model.Count();
}

<div class="row align-items-center mb-3">
    <div class="col">
        <h1 class="mb-0">Estudiantes</h1>
        <p class="text-secondary mb-0">Registro y expedientes de alumnos matriculados.</p>
    </div>
    <div class="col-auto">
        @Html.ActionLink("+ Nuevo expediente", "CrearExpediente", null, new { @class = "btn btn-primary" })
    </div>
</div>

<div class="row row-cards g-3 mb-3">
    <div class="col-sm-4">
        <div class="card card-sm shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">Total de expedientes</div>
                <div class="h2 mb-0">@total</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h3 class="card-title mb-0">Listado</h3>
    </div>

    @if (!Model.Any())
    {
        <div class="card-body">
            <div class="empty">
                <p class="empty-title">No hay expedientes registrados</p>
                <div class="empty-action">
                    @Html.ActionLink("+ Nuevo expediente", "CrearExpediente", null, new { @class = "btn btn-primary" })
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vcenter card-table" id="myTable">
                <thead>
                    <tr>
                        <th>Estudiante</th>
                        <th>@Html.DisplayNameFor(model => model.identificacion)</th>
                        <th>Grado</th>
                        <th>Expediente</th>
                        <th class="w-1">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        string inicial = string.IsNullOrEmpty(item.nombre) ? "?" : item.nombre.Substring(0, 1).ToUpper();
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <span class="avatar avatar-sm rounded-circle bg-teal-lt fw-bold me-2">@inicial</span>
                                    <div class="fw-medium">@(string.IsNullOrEmpty(item.nombre) ? "Prematrícula no encontrada" : (item.nombre + " " + item.apellido1 + " " + item.apellido2).Trim())</div>
                                </div>
                            </td>
                            <td>@Html.DisplayFor(modelItem => item.identificacion)</td>
                            <td>@(string.IsNullOrEmpty(item.nombre_grado) ? "No disponible" : item.nombre_grado)</td>
                            <td><span class="text-secondary">#@item.id_expediente</span></td>
                            <td class="text-nowrap">
                                @Html.ActionLink("Ver detalle", "DetalleDeExpediente", new { id = item.id_expediente }, new { @class = "btn btn-sm btn-outline-secondary me-1" })
                                @if (!string.IsNullOrEmpty(item.identificacion))
                                {
                                    @Html.ActionLink("Editar", "EditarExpediente", new { id = item.id_expediente }, new { @class = "btn btn-sm btn-primary" })
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section scripts
{
    <script src="~/Scripts/General/General.js"></script>
}