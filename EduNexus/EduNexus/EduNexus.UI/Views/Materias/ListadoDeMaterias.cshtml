@model IEnumerable<EduNexus.Abstracciones.ModelosParaUI.Materias.MateriasDto>

@{
    ViewBag.Title = "Listado de materias";
    int total = Model.Count();
    int sinProfesor = Model.Count(x => string.IsNullOrEmpty(x.profesor));
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Académico</div>
            <h2 class="page-title">Materias</h2>
            <div class="page-subtitle">Asignaturas y docente encargado de cada una.</div>
        </div>
        <div class="col-12 col-md-auto ms-auto">
            <div class="btn-list">
                @Html.ActionLink("Materias por sección", "ListadoDeAsignaciones", "SeccionMaterias", null, new { @class = "btn btn-outline-secondary" })
                @Html.ActionLink("Nueva materia", "CrearMateria", null, new { @class = "btn btn-primary" })
            </div>
        </div>
    </div>
</div>

<div class="row row-cards g-3 mb-3">
    <div class="col-sm-6">
        <div class="card card-sm">
            <div class="card-body">
                <div class="text-secondary small">Total de materias</div>
                <div class="h2 mb-0">@total</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="card card-sm">
            <div class="card-body">
                <div class="text-secondary small">Sin profesor asignado</div>
                <div class="h2 mb-0 @(sinProfesor > 0 ? "text-danger" : "")">@sinProfesor</div>
            </div>
        </div>
    </div>
</div>

<div class="row row-cards g-3">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card">
                <div class="empty">
                    <div class="empty-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M3 19a9 9 0 0 1 9 0a9 9 0 0 1 9 0" /><path d="M3 6a9 9 0 0 1 9 0a9 9 0 0 1 9 0" /><path d="M3 6v13" /><path d="M12 6v13" /><path d="M21 6v13" /></svg>
                    </div>
                    <p class="empty-title">No hay materias registradas</p>
                    <p class="empty-subtitle text-secondary">Cree la primera materia para poder asignarla a las secciones.</p>
                    <div class="empty-action">
                        @Html.ActionLink("Nueva materia", "CrearMateria", null, new { @class = "btn btn-primary" })
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        foreach (var item in Model)
        {
            bool sinProf = string.IsNullOrEmpty(item.profesor);
            <div class="col-sm-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <h3 class="card-title mb-1">@Html.DisplayFor(modelItem => item.nombre)</h3>
                        <div class="d-flex align-items-center mt-2">
                            <span class="avatar avatar-sm rounded-circle @(sinProf ? "bg-red-lt" : "bg-purple-lt") fw-bold me-2">
                                @(sinProf ? "?" : item.profesor.Substring(0, 1).ToUpper())
                            </span>
                            <div>
                                <div class="fw-medium">@(sinProf ? "Sin profesor asignado" : item.profesor)</div>
                                <div class="text-secondary small">Profesor encargado</div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer d-flex justify-content-end">
                        @Html.ActionLink("Editar", "EditarMateria", new { id = item.id_materia }, new { @class = "btn btn-sm btn-outline-secondary" })
                    </div>
                </div>
            </div>
        }
    }
</div>

@section scripts
{
    <script src="~/Scripts/General/General.js"></script>
}
