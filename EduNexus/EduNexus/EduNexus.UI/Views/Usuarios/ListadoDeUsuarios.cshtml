@model IEnumerable<EduNexus.Abstracciones.ModelosParaUI.Usuarios.UsuarioDto>

@{
    ViewBag.Title = "Listado de usuarios";
    int total = Model.Count();
    int activos = Model.Count(x => x.estado == "Activo");
    int bloqueados = total - activos;
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Seguridad</div>
            <h2 class="page-title">Usuarios</h2>
            <div class="page-subtitle">Administre las cuentas de acceso al sistema.</div>
        </div>
        <div class="col-12 col-md-auto ms-auto">
            <div class="btn-list">
                @Html.ActionLink("Nuevo usuario", "CrearUsuario", null, new { @class = "btn btn-primary" })
            </div>
        </div>
    </div>
</div>

<div class="row row-cards g-3 mb-3">
    <div class="col-sm-4">
        <div class="card card-sm">
            <div class="card-body">
                <div class="text-secondary small">Total de usuarios</div>
                <div class="h2 mb-0">@total</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card card-sm">
            <div class="card-body">
                <div class="text-secondary small">Activos</div>
                <div class="h2 mb-0 text-success">@activos</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card card-sm">
            <div class="card-body">
                <div class="text-secondary small">Bloqueados/Inactivos</div>
                <div class="h2 mb-0 text-danger">@bloqueados</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Listado de usuarios</h3>
        <div class="card-actions text-secondary small">@total usuario(s)</div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty">
            <div class="empty-icon">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M9 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" /><path d="M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /><path d="M21 21v-2a4 4 0 0 0 -3 -3.85" /></svg>
            </div>
            <p class="empty-title">No hay usuarios registrados</p>
            <p class="empty-subtitle text-secondary">Cuando agregue un usuario aparecerá en este listado.</p>
            <div class="empty-action">
                @Html.ActionLink("Nuevo usuario", "CrearUsuario", null, new { @class = "btn btn-primary" })
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vcenter card-table" id="myTable">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>@Html.DisplayNameFor(model => model.cedula)</th>
                        <th>@Html.DisplayNameFor(model => model.correo)</th>
                        <th>@Html.DisplayNameFor(model => model.nombreRol)</th>
                        <th>@Html.DisplayNameFor(model => model.estado)</th>
                        <th class="en-acciones">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        string inicial = string.IsNullOrWhiteSpace(item.nombre) ? "?" : item.nombre.Trim().Substring(0, 1).ToUpper();
                        string nombreJs = System.Web.HttpUtility.JavaScriptStringEncode((item.nombre + " " + item.apellido1).Trim());
                        bool estaActivo = item.estado == "Activo";
                        string estadoBadge = estaActivo ? "green" : "red";
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <span class="avatar avatar-sm rounded-circle bg-blue-lt fw-bold me-2">@inicial</span>
                                    <div>
                                        <div class="fw-medium">@item.nombre @item.apellido1 @item.apellido2</div>
                                    </div>
                                </div>
                            </td>
                            <td class="text-nowrap">@Html.DisplayFor(modelItem => item.cedula)</td>
                            <td><a href="mailto:@item.correo">@item.correo</a></td>
                            <td>
                                @item.nombreRol
                                @if (EduNexus.UI.Models.RolesSistema.Es(item.nombreRol, EduNexus.UI.Models.RolesSistema.Docente))
                                {
                                    <div>@Html.ActionLink("Ver ficha del docente", "CargaAcademicaDocente", "Docentes", new { id = item.id_usuario }, new { @class = "small" })</div>
                                }
                            </td>
                            <td><span class="badge bg-@(estadoBadge)-lt">@item.estado</span></td>
                            <td class="en-acciones">
                                @if (estaActivo)
                                {
                                    using (Html.BeginForm("BloquearUsuario", "Usuarios", new { id = item.id_usuario }, FormMethod.Post, new { style = "display:inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('¿Bloquear/desactivar a @(nombreJs)?');">
                                            Bloquear
                                        </button>
                                    }
                                }
                                else
                                {
                                    using (Html.BeginForm("ActivarUsuario", "Usuarios", new { id = item.id_usuario }, FormMethod.Post, new { style = "display:inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-success"
                                                onclick="return confirm('¿Reactivar a @(nombreJs)?');">
                                            Reactivar
                                        </button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section scripts {
    <script src="~/Scripts/General/General.js"></script>
}
