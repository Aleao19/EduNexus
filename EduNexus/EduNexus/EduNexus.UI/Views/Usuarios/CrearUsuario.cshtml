@model EduNexus.Abstracciones.ModelosParaUI.Usuarios.UsuarioDto

@{
    ViewBag.Title = "Registrar usuario";
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Seguridad</div>
            <h2 class="page-title">Registrar nuevo usuario</h2>
            <div class="page-subtitle">Cree una cuenta de acceso al sistema y asígnele un rol.</div>
        </div>
    </div>
</div>

<div class="alert alert-info">
    Los docentes se registran en <a href="@Url.Action("CrearDocente", "Docentes")" class="alert-link">Académico → Docentes</a>,
    donde también se les asignan sus materias y secciones.
</div>

<div class="card">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="card-header">
            <h3 class="card-title">Datos del usuario</h3>
        </div>
        <div class="card-body">
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

            <div class="row g-3">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.cedula, new { @class = "form-label required" })
                    @Html.TextBoxFor(model => model.cedula, new { @class = "form-control", placeholder = EduNexus.UI.Models.Cedula.Formato, maxlength = "11", pattern = "\\d-\\d{4}-\\d{4}", title = EduNexus.UI.Models.Cedula.MensajeFormato, autocomplete = "off" })
                    <small class="form-hint">Formato 0-0000-0000. No se puede modificar después de registrada.</small>
                    @Html.ValidationMessageFor(model => model.cedula, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(model => model.correo, new { @class = "form-label required" })
                    @Html.TextBoxFor(model => model.correo, new { @class = "form-control", placeholder = "usuario@mep.go.cr" })
                    @Html.ValidationMessageFor(model => model.correo, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-4">
                    @Html.LabelFor(model => model.nombre, new { @class = "form-label required" })
                    @Html.TextBoxFor(model => model.nombre, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.nombre, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-4">
                    @Html.LabelFor(model => model.apellido1, new { @class = "form-label required" })
                    @Html.TextBoxFor(model => model.apellido1, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.apellido1, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-4">
                    @Html.LabelFor(model => model.apellido2, new { @class = "form-label" })
                    @Html.TextBoxFor(model => model.apellido2, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.apellido2, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(model => model.id_rol, new { @class = "form-label required" })
                    @Html.DropDownList("id_rol", (SelectList)ViewBag.Roles, "-- Seleccione un rol --", new { @class = "form-select" })
                    @Html.ValidationMessageFor(model => model.id_rol, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(model => model.estado, new { @class = "form-label required" })
                    @Html.DropDownListFor(model => model.estado, new List<SelectListItem>
                    {
                        new SelectListItem { Text = "Activo", Value = "Activo" },
                        new SelectListItem { Text = "Inactivo", Value = "Inactivo" }
                    }, new { @class = "form-select" })
                    @Html.ValidationMessageFor(model => model.estado, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(model => model.contrasenna, new { @class = "form-label required" })
                    @Html.PasswordFor(model => model.contrasenna, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.contrasenna, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="card-footer en-form-acciones">
            @Html.ActionLink("Cancelar", "ListadoDeUsuarios", null, new { @class = "btn btn-outline-secondary" })
            <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Da formato 0-0000-0000 a la cédula mientras se escribe
        (function () {
            var campo = document.getElementById('cedula');
            if (!campo) return;
            campo.addEventListener('input', function () {
                var d = campo.value.replace(/\D/g, '').substring(0, 9);
                var f = d.substring(0, 1);
                if (d.length > 1) f += '-' + d.substring(1, 5);
                if (d.length > 5) f += '-' + d.substring(5, 9);
                campo.value = f;
            });
        })();
    </script>
}
