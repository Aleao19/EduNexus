@model EduNexus.Abstracciones.ModelosParaUI.Grados.GradosDto

@{
    ViewBag.Title = "Eliminar grado";
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Académico</div>
            <h2 class="page-title">Eliminar grado</h2>
            <div class="page-subtitle">Revise la información antes de confirmar la eliminación.</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">¿Está seguro de que desea eliminar este grado?</h3>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="en-dato-label">@Html.DisplayNameFor(model => model.grado)</div>
                <div class="en-dato-valor">@Html.DisplayFor(model => model.grado)</div>
            </div>
            <div class="col-md-4">
                <div class="en-dato-label">@Html.DisplayNameFor(model => model.descripcion)</div>
                <div class="en-dato-valor">@Html.DisplayFor(model => model.descripcion)</div>
            </div>
            <div class="col-md-4">
                <div class="en-dato-label">Secciones asociadas</div>
                <div class="en-dato-valor">@ViewBag.CantidadSecciones</div>
            </div>
        </div>
    </div>
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.id_grado)

        <div class="card-footer en-form-acciones">
            @Html.ActionLink("Cancelar", "ListadoDeGrados", null, new { @class = "btn btn-outline-secondary" })
            <input type="submit" value="Eliminar" class="btn btn-danger" />
        </div>
    }
</div>
