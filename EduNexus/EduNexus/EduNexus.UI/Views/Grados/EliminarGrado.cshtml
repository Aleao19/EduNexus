@model EduNexus.Abstracciones.ModelosParaUI.Grados.GradosDto

@{
    ViewBag.Title = "Eliminar grado";
}

<h2>Eliminar grado</h2>

<h4>¿Está seguro que desea eliminar este grado?</h4>

<div>
    <hr />
    <div class="container my-2">
        <div class="row">
            <div class="col-md-8 offset-md-1">
                <div class="form-group">
                    <dl class="dl-horizontal">
                        <dt>
                            @Html.DisplayNameFor(model => model.grado)
                        </dt>
                        <dd>
                            @Html.DisplayFor(model => model.grado)
                        </dd>

                        <dt>
                            @Html.DisplayNameFor(model => model.descripcion)
                        </dt>
                        <dd>
                            @Html.DisplayFor(model => model.descripcion)
                        </dd>

                        <dt>
                            Secciones asociadas
                        </dt>
                        <dd>
                            @ViewBag.CantidadSecciones
                        </dd>
                    </dl>
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.id_grado)

                    <div class="form-group my-3">
                        <input type="submit" value="Eliminar" class="btn btn-danger" />
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div>
    @Html.ActionLink("Regresar", "ListadoDeGrados")
</div>
