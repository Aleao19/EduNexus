@model EduNexus.Abstracciones.ModelosParaUI.Grados.GradosDto

@{
    ViewBag.Title = "Editar grado";
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Académico</div>
            <h2 class="page-title">Editar grado</h2>
            <div class="page-subtitle">Actualice el número y la descripción del grado.</div>
        </div>
    </div>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.id_grado)

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Datos del grado</h3>
        </div>
        <div class="card-body">

            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

            <div class="row g-3">

                <div class="col-md-6">
                    @Html.LabelFor(model => model.grado, htmlAttributes: new { @class = "form-label required" })
                    @Html.EditorFor(model => model.grado, new { htmlAttributes = new { @class = "form-control" } })
                    <small class="form-hint">Número del 1 al 6.</small>
                    @Html.ValidationMessageFor(model => model.grado, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(model => model.descripcion, htmlAttributes: new { @class = "form-label required" })
                    @Html.EditorFor(model => model.descripcion, new { htmlAttributes = new { @class = "form-control" } })
                    <small class="form-hint">Nombre con el que se mostrará el grado, por ejemplo «Primer grado».</small>
                    @Html.ValidationMessageFor(model => model.descripcion, "", new { @class = "text-danger" })
                </div>

            </div>
        </div>
        <div class="card-footer en-form-acciones">
            @Html.ActionLink("Cancelar", "ListadoDeGrados", null, new { @class = "btn btn-outline-secondary" })
            <input type="submit" value="Guardar" class="btn btn-primary" />
        </div>
    </div>
}

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}
