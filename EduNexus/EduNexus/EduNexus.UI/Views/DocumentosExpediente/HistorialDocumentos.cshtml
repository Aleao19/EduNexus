@using System.Linq
@model IEnumerable<EduNexus.Abstracciones.ModelosParaUI.Expedientes.DocumentoExpedienteDto>

@{
    ViewBag.Title = "Historial de documentos";
    int idExpediente = (int)ViewBag.IdExpediente;
    string estudiante = ViewBag.Estudiante as string;
}

<div class="row align-items-center mb-3">
    <div class="col">
        <h1 class="mb-0">Historial de documentos</h1>
        <p class="text-secondary mb-0">
            Expediente #@idExpediente
            @if (!string.IsNullOrWhiteSpace(estudiante))
            {
                <span>· @estudiante</span>
            }
        </p>
    </div>
    <div class="col-auto">
        @Html.ActionLink("+ Adjuntar documento", "AdjuntarDocumento", "DocumentosExpediente", new { id_expediente = idExpediente }, new { @class = "btn btn-primary me-1" })
        @Html.ActionLink("Regresar al expediente", "DetalleDeExpediente", "Expedientes", new { id = idExpediente }, new { @class = "btn btn-outline-secondary" })
    </div>
</div>

<div class="card shadow-sm">
    @if (Model == null || !Model.Any())
    {
        <div class="card-body text-secondary">
            No hay documentos registrados para este expediente.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>Nombre del documento</th>
                        <th>Descripción</th>
                        <th>Archivo</th>
                        <th>Tamaño</th>
                        <th>Fecha de registro</th>
                        <th>Registrado por</th>
                        <th class="w-1">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var documento in Model)
                    {
                        <tr>
                            <td class="fw-medium">@documento.nombre_documento</td>
                            <td>@(string.IsNullOrWhiteSpace(documento.descripcion) ? "Sin descripción" : documento.descripcion)</td>
                            <td>@documento.nombre_archivo</td>
                            <td class="text-nowrap">@((documento.tamano_bytes / 1024.0).ToString("0.#")) KB</td>
                            <td class="text-nowrap">@documento.fecha_registro.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(string.IsNullOrWhiteSpace(documento.registrado_por) ? "No disponible" : documento.registrado_por)</td>
                            <td>
                                @Html.ActionLink("Descargar", "Descargar", "DocumentosExpediente", new { id = documento.id_documento }, new { @class = "btn btn-sm btn-outline-primary" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
