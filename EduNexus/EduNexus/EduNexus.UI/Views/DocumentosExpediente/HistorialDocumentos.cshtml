
@using System.Linq
@model IEnumerable<EduNexus.Abstracciones.ModelosParaUI.Expedientes.DocumentoExpedienteDto>

@{
    ViewBag.Title = "Historial de documentos";
    int idExpediente = (int)ViewBag.IdExpediente;
}

<h2>Historial de documentos</h2>

<hr />

<div class="container">

    <h4>Expediente N.º @idExpediente</h4>

    <p>
        En esta sección se mostrarán los documentos
        asociados al expediente estudiantil.
    </p>

    <div class="table-responsive">

        <table class="table table-bordered table-striped">

            <thead>
                <tr>
                    <th>Nombre del documento</th>
                    <th>Descripción</th>
                    <th>Nombre del archivo</th>
                    <th>Fecha de registro</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var documento in Model)
                    {
                        <tr>
                            <td>
                                @documento.nombre_documento
                            </td>

                            <td>
                                @documento.descripcion
                            </td>

                            <td>
                                @documento.nombre_archivo
                            </td>

                            <td>
                                @documento.fecha_registro.ToString("dd/MM/yyyy HH:mm")
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center">
                            No hay documentos registrados
                            para este expediente.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

    <div class="my-3">

        @Html.ActionLink(
            "Adjuntar documento",
            "AdjuntarDocumento",
            "DocumentosExpediente",
            new { id_expediente = idExpediente },
            new { @class = "btn btn-cyan" }
        )

        @Html.ActionLink(
            "Regresar al expediente",
            "DetalleDeExpediente",
            "Expedientes",
            new { id = idExpediente },
            new { @class = "btn btn-default" }
        )

    </div>

</div>
