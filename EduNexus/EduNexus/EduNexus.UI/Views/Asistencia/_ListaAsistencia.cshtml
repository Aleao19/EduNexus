
@model EduNexus.Abstracciones.ModelosParaUI.Asistencia.AsistenciaFormDto

@{
    string[] estados = EduNexus.Abstracciones.ModelosParaUI.Asistencia.AsistenciaFormDto.Estados;
    string[] colores = { "success", "warning", "danger", "info" };
    string fechaTexto = Model.fecha.HasValue ? Model.fecha.Value.ToString("yyyy-MM-dd") : "";
    bool soloLectura = Model.yaRegistrado && !Model.esEdicion;
    string estadoJustificado = EduNexus.Abstracciones.ModelosParaUI.Asistencia.AsistenciaFormDto.EstadoJustificado;
    int maximoMotivo = EduNexus.Abstracciones.ModelosParaUI.Asistencia.AsistenciaFormDto.MaximoMotivo;
}

@if (!string.IsNullOrEmpty(Model.mensajeError))
{
    <div class="alert alert-danger">@Model.mensajeError</div>
}
else if (!string.IsNullOrEmpty(Model.titulo))
{
    if (!string.IsNullOrEmpty(Model.mensajeExito))
    {
        <div class="alert alert-success">@Model.mensajeExito</div>
    }

    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

    if (!Model.estudiantes.Any())
    {
        <div class="alert alert-info">La sección no tiene estudiantes asignados.</div>
    }
    else if (soloLectura)
    {
        @* Escenario 3: la fecha ya tiene lista. Se muestra lo guardado y la opción de editar *@
        <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2">
            <span>Ya existe una lista de asistencia para el @Model.fecha.Value.ToString("dd/MM/yyyy").</span>
            <a href="@Model.urlEditar" class="btn btn-primary btn-sm ms-auto asist-ajax">Editar lista de este día</a>
        </div>

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h3 class="card-title">@Model.titulo - @Model.fecha.Value.ToString("dd/MM/yyyy")</h3>
                @if (!string.IsNullOrEmpty(Model.urlHistorial))
                {
                    <a href="@Model.urlHistorial" class="btn btn-outline-secondary btn-sm">Ver historial</a>
                }
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Estudiante</th>
                            <th>Estado guardado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var est in Model.estudiantes)
                        {
                            int posicion = Array.IndexOf(estados, est.estado);
                            string color = posicion >= 0 ? colores[posicion] : "secondary";
                            <tr>
                                <td>@est.nombre</td>
                                <td>
                                    <span class="@("badge bg-" + color + "-lt")">@est.estado</span>
                                    @if (est.estado == estadoJustificado)
                                    {
                                        string detalle = (est.justificado_por != null ? "Justificado por " + est.justificado_por : "Justificado")
                                            + (est.fecha_justificacion.HasValue ? " el " + est.fecha_justificacion.Value.ToString("dd/MM/yyyy HH:mm") : "");
                                        <div class="small mt-1" title="@detalle">
                                            <span class="text-secondary">Motivo:</span>
                                            @(string.IsNullOrEmpty(est.motivo_justificacion) ? "No registrado" : est.motivo_justificacion)
                                        </div>
                                        <div class="small text-secondary">@detalle</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <form method="post" action="@Model.urlGuardar" class="@("asist-lista" + (Model.modoAjax ? " asist-ajax" : ""))">
            @Html.AntiForgeryToken()
            <input type="hidden" name="clase" value="@Model.clase" />
            <input type="hidden" name="fecha" value="@fechaTexto" />
            <input type="hidden" name="esEdicion" value="@Model.esEdicion.ToString().ToLower()" />

            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h3 class="card-title">
                        @Model.titulo - @Model.fecha.Value.ToString("dd/MM/yyyy")
                        @if (Model.esEdicion)
                        {
                            <span class="badge bg-azure-lt ms-2">Editando</span>
                        }
                    </h3>
                    <div class="d-flex align-items-center flex-wrap gap-2">
                        <div class="small text-secondary">
                            Presentes: <span id="contPresentes" class="fw-bold text-success">0</span> ·
                            Tardías: <span id="contTardias" class="fw-bold text-warning">0</span> ·
                            Ausencias: <span id="contAusentes" class="fw-bold text-danger">0</span> ·
                            Sin marcar: <span id="contSinMarcar" class="fw-bold">0</span>
                        </div>
                        <button type="button" class="btn btn-outline-success btn-sm" id="btnTodosPresentes">Marcar todos presentes</button>
                        @if (!string.IsNullOrEmpty(Model.urlHistorial))
                        {
                            <a href="@Model.urlHistorial" class="btn btn-outline-secondary btn-sm">Ver historial</a>
                        }
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th class="w-1">#</th>
                                <th>Estudiante</th>
                                <th>Estado de asistencia</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.estudiantes.Count; i++)
                            {
                                var est = Model.estudiantes[i];
                                bool muestraMotivo = est.estado == estadoJustificado;

                                <tr class="@(est.sinMarcar || est.errorMotivo != null ? "table-danger" : "")">
                                    <td class="text-secondary">@(i + 1)</td>
                                    <td>
                                        @est.nombre
                                        <input type="hidden" name="estudiantes[@i].id_usuario" value="@est.id_usuario" />
                                    </td>
                                    <td>
                                        <select name="estudiantes[@i].estado"
                                                class="form-select form-select-sm asist-estado"
                                                required>
                                            <option value="">-- Seleccione un estado --</option>
                                            @for (int k = 0; k < estados.Length; k++)
                                            {
                                                <option value="@estados[k]" @(est.estado == estados[k] ? "selected" : "")>
                                                    @estados[k]
                                                </option>
                                            }
                                        </select>

                                        @* El motivo es obligatorio cuando la ausencia es justificada *@
                                        <div class="@("asist-motivo mt-2" + (muestraMotivo ? "" : " d-none"))">
                                            <label class="form-label small mb-1" for="@("motivo_" + i)">
                                                Motivo de la justificación <span class="text-danger">*</span>
                                            </label>
                                            <textarea id="@("motivo_" + i)"
                                                      name="estudiantes[@i].motivo_justificacion"
                                                      rows="2"
                                                      maxlength="@maximoMotivo"
                                                      class="@("form-control form-control-sm" + (est.errorMotivo != null ? " is-invalid" : ""))"
                                                      placeholder="Ej.: dictamen médico, cita, trámite familiar..."
                                                      @(muestraMotivo ? "required" : "")>@est.motivo_justificacion</textarea>

                                            @if (est.errorMotivo != null)
                                            {
                                                <div class="invalid-feedback d-block">@est.errorMotivo</div>
                                            }

                                            @if (est.justificado_por != null)
                                            {
                                                <div class="form-hint small">
                                                    @("Justificado por " + est.justificado_por + (est.fecha_justificacion.HasValue ? " el " + est.fecha_justificacion.Value.ToString("dd/MM/yyyy HH:mm") : ""))
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="card-footer en-form-acciones">
                    @if (Model.esEdicion)
                    {
                        <a href="@Model.urlCancelar" class="@("btn btn-outline-secondary" + (Model.modoAjax ? " asist-ajax" : ""))">Cancelar</a>
                    }
                    <input type="submit" value="Guardar asistencia" class="btn btn-primary" />
                </div>
            </div>
        </form>
    }
}
