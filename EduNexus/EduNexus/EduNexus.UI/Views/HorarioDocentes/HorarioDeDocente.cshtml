@model EduNexus.Abstracciones.ModelosParaUI.Docentes.HorarioDocenteDto

@{
    ViewBag.Title = "Horario del docente";
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Académico</div>
            <h2 class="page-title">Horario del docente</h2>
            <div class="page-subtitle">@Model.docente · @Model.identificacion · @Model.email</div>
        </div>
        <div class="col-12 col-md-auto ms-auto">
            <div class="btn-list">
                @Html.ActionLink("Regresar", "BuscarDocente", null, new { @class = "btn btn-outline-secondary" })
                @Html.ActionLink("Ver ficha del docente", "CargaAcademicaDocente", "Docentes", new { id = Model.id_usuario }, new { @class = "btn btn-outline-secondary" })
            </div>
        </div>
    </div>
</div>

@if (!Model.horarios.Any())
{
    @* Escenario 2: docente registrado sin horario asignado *@
    <div class="alert alert-info d-flex flex-wrap align-items-center gap-2">
        <span>El docente no tiene horario asignado.</span>
        @if (ViewBag.TieneClases == true)
        {
            @Html.ActionLink("Asignar horario", "ListadoDeHorarios", "Horarios", null, new { @class = "btn btn-primary btn-sm ms-auto" })
        }
        else
        {
            @Html.ActionLink("Asignar materia y sección", "AsignarDocente", "Docentes", new { id = Model.id_usuario }, new { @class = "btn btn-primary btn-sm ms-auto" })
        }
    </div>
}
else
{
    @* Escenario 1: horario completo del docente *@
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Clases asignadas</h3>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>Día</th>
                        <th>Hora</th>
                        <th>Materia</th>
                        <th>Sección</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.horarios)
                    {
                        <tr>
                            <td><span class="badge bg-blue-lt">@item.dia_semana</span></td>
                            <td class="text-nowrap">@item.hora_inicio - @item.hora_fin</td>
                            <td>@item.materia</td>
                            <td>@item.seccion</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
