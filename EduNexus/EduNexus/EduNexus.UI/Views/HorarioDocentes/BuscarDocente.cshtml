@model IEnumerable<EduNexus.Abstracciones.ModelosParaUI.Docentes.DocenteBusquedaDto>

@{
    ViewBag.Title = "Consultar horario de docente";
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Académico</div>
            <h2 class="page-title">Horario de docentes</h2>
            <div class="page-subtitle">Busque un docente y seleccione su nombre para ver su horario.</div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        @using (Html.BeginForm("BuscarDocente", "HorarioDocentes", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
        {
            <div class="col-md-6">
                <label class="form-label">Buscar docente</label>
                <input type="text" name="q" value="@ViewBag.Busqueda" class="form-control" placeholder="Buscar por nombre, identificación o correo..." />
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary">Buscar</button>
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Docentes</h3>
    </div>
    @if (!Model.Any())
    {
        <div class="empty">
            <div class="empty-icon">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" /><path d="M21 21l-6 -6" /></svg>
            </div>
            <p class="empty-title">No se encontraron docentes</p>
            <p class="empty-subtitle text-secondary">No hay docentes registrados que coincidan con esa búsqueda.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>Docente</th>
                        <th>Cédula</th>
                        <th>Correo</th>
                        <th>Estado</th>
                        <th class="en-acciones">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-medium">@item.nombre</td>
                            <td class="text-nowrap">@item.identificacion</td>
                            <td>@item.email</td>
                            <td><span class="badge @(item.estado == "Activo" ? "bg-green-lt" : "bg-red-lt")">@item.estado</span></td>
                            <td class="en-acciones">
                                <div class="btn-list">
                                    @Html.ActionLink("Ver horario", "HorarioDeDocente", new { id = item.id_usuario }, new { @class = "btn btn-sm btn-outline-primary" })
                                    @Html.ActionLink("Ver ficha", "CargaAcademicaDocente", "Docentes", new { id = item.id_usuario }, new { @class = "btn btn-sm btn-outline-secondary" })
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
