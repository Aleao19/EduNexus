@model IEnumerable<EduNexus.Abstracciones.ModelosParaUI.SalidasEstudiantes.SalidaEstudianteDto>

@using System
@using System.Linq
@using System.Web.Mvc
@using System.Collections.Generic

@{
    ViewBag.Title = "Historial de salidas de estudiantes";

    int totalSalidas =
        Convert.ToInt32(ViewBag.TotalSalidas ?? 0);

    int totalEstudiantes =
        Convert.ToInt32(ViewBag.TotalEstudiantes ?? 0);

    int salidasHoy =
        Convert.ToInt32(ViewBag.SalidasHoy ?? 0);

    string fechaDesde =
        Convert.ToString(ViewBag.FechaDesde ?? "");

    string fechaHasta =
        Convert.ToString(ViewBag.FechaHasta ?? "");

    var grados = ViewBag.Grados as SelectList
        ?? new SelectList(
            new List<SelectListItem>(),
            "Value",
            "Text");

    var secciones = ViewBag.Secciones as SelectList
        ?? new SelectList(
            new List<SelectListItem>(),
            "Value",
            "Text");

    var estudiantes = ViewBag.Estudiantes as SelectList
        ?? new SelectList(
            new List<SelectListItem>(),
            "Value",
            "Text");

    int totalResultados =
        Model != null ? Model.Count() : 0;
}

<style>

    .historial-contenedor {
        max-width: 1500px;
        margin: 30px auto;
        padding: 20px;
    }

    .historial-encabezado {
        margin-bottom: 25px;
    }

    .historial-encabezado h2 {
        color: #24364b;
        font-weight: bold;
    }

    .historial-encabezado p {
        color: #64748b;
    }

    .historial-botones {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 20px;
    }

    .historial-resumen {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 25px;
    }

    .historial-tarjeta {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 25px;
        box-shadow: 0 3px 8px rgba(0,0,0,0.05);
    }

    .historial-tarjeta span {
        display: block;
        font-size: 14px;
        font-weight: bold;
        color: #64748b;
    }

    .historial-tarjeta h3 {
        font-size: 32px;
        font-weight: bold;
        margin: 12px 0 0;
    }

    .tarjeta-total {
        border-left: 5px solid #2563eb;
    }

    .tarjeta-estudiantes {
        border-left: 5px solid #16a34a;
    }

    .tarjeta-hoy {
        border-left: 5px solid #d97706;
    }

    .color-azul {
        color: #2563eb;
    }

    .color-verde {
        color: #16a34a;
    }

    .color-amarillo {
        color: #d97706;
    }

    .historial-panel {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 25px;
        box-shadow: 0 3px 8px rgba(0,0,0,0.05);
    }

    .historial-panel h4 {
        color: #24364b;
        font-weight: bold;
        margin-bottom: 20px;
    }

    .historial-filtros {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: 20px;
        align-items: end;
    }

    .historial-filtro label {
        display: block;
        color: #334155;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .historial-filtro input,
    .historial-filtro select {
        width: 100%;
        max-width: 100%;
    }

    .historial-tabla {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

    .historial-tabla thead th {
        background: #24364b;
        color: #ffffff;
        padding: 14px;
        text-align: center;
        vertical-align: middle;
        white-space: nowrap;
    }

    .historial-tabla tbody td {
        padding: 14px;
        border-bottom: 1px solid #e2e8f0;
        vertical-align: middle;
        text-align: center;
    }

    .historial-tabla tbody tr:nth-child(even) {
        background: #f8fafc;
    }

    .historial-tabla tbody tr:hover {
        background: #eff6ff;
    }

    .historial-tabla .texto-izquierda {
        text-align: left;
    }

    .historial-motivo {
        min-width: 200px;
        max-width: 350px;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        text-align: left !important;
    }

    .historial-observaciones {
        min-width: 180px;
        max-width: 300px;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        text-align: left !important;
    }

    .historial-persona {
        min-width: 200px;
    }

    .texto-secundario {
        color: #64748b;
        font-size: 13px;
        margin-top: 4px;
    }

    .estado-salida {
        display: inline-block;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: bold;
        white-space: nowrap;
    }

    .estado-registrada {
        background: #dcfce7;
        color: #166534;
    }

    .estado-anulada {
        background: #fee2e2;
        color: #b91c1c;
    }

    .estado-desconocido {
        background: #e2e8f0;
        color: #475569;
    }

    .historial-informacion {
        background: #eff6ff;
        border-left: 5px solid #2563eb;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 25px;
        color: #334155;
    }

    .historial-informacion h5 {
        color: #1e40af;
        font-weight: bold;
    }

    .historial-vacio {
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
        border-radius: 12px;
        padding: 40px;
        text-align: center;
        color: #64748b;
    }

    .historial-resultados {
        color: #64748b;
        font-size: 14px;
        margin-bottom: 15px;
    }

    .historial-error {
        color: #dc2626;
        font-size: 13px;
        margin-top: 8px;
        display: none;
    }

    .validation-summary-valid {
        display: none;
    }

    .validation-summary-errors {
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
    }

    @@media (max-width: 768px) {

        .historial-contenedor {
            padding: 10px;
            margin: 15px auto;
        }

        .historial-panel {
            padding: 15px;
        }

        .historial-botones .btn {
            width: 100%;
        }

        .historial-filtros {
            grid-template-columns: 1fr;
        }
    }

</style>

<div class="historial-contenedor">

    <!-- ======================================== -->
    <!-- ENCABEZADO -->
    <!-- ======================================== -->

    <div class="historial-encabezado">

        <h2>Historial de salidas de estudiantes</h2>

        <p>
            Consulte los registros de salidas anticipadas
            de los estudiantes durante la jornada escolar.
        </p>

        <div class="historial-botones">

            <a href="@Url.Action("Registrar", "SalidasEstudiantes")"
               class="btn btn-success">

                Registrar nueva salida

            </a>

            <a href="@Url.Action("Index", "Home")"
               class="btn btn-secondary">

                Volver al inicio

            </a>

        </div>

    </div>

    <!-- ======================================== -->
    <!-- RESUMEN ESTADÍSTICO -->
    <!-- ======================================== -->

    <div class="historial-resumen">

        <div class="historial-tarjeta tarjeta-total">

            <span>Total de salidas</span>

            <h3 class="color-azul">
                @totalSalidas
            </h3>

        </div>

        <div class="historial-tarjeta tarjeta-estudiantes">

            <span>Estudiantes con salidas</span>

            <h3 class="color-verde">
                @totalEstudiantes
            </h3>

        </div>

        <div class="historial-tarjeta tarjeta-hoy">

            <span>Salidas registradas hoy</span>

            <h3 class="color-amarillo">
                @salidasHoy
            </h3>

        </div>

    </div>

    <p class="texto-secundario">
        Las estadísticas corresponden a los filtros seleccionados.
    </p>

    <!-- ======================================== -->
    <!-- FILTROS DE BÚSQUEDA -->
    <!-- ======================================== -->

    <div class="historial-panel">

        <h4>Filtros de búsqueda</h4>

        @using (Html.BeginForm(
            "Historial",
            "SalidasEstudiantes",
            FormMethod.Get,
            new { id = "formFiltrosSalidas" }))
        {
            @Html.ValidationSummary(
                false,
                "Revise los filtros seleccionados.",
                new { @class = "validation-summary" })

            <div class="historial-filtros">

                <div class="historial-filtro">

                    <label for="fecha_desde">
                        Fecha desde
                    </label>

                    <input type="date"
                           name="fecha_desde"
                           id="fecha_desde"
                           value="@fechaDesde"
                           class="form-control" />

                </div>

                <div class="historial-filtro">

                    <label for="fecha_hasta">
                        Fecha hasta
                    </label>

                    <input type="date"
                           name="fecha_hasta"
                           id="fecha_hasta"
                           value="@fechaHasta"
                           class="form-control" />

                </div>

                <div class="historial-filtro">

                    <label for="id_grado">
                        Grado
                    </label>

                    @Html.DropDownList(
                        "id_grado",
                        grados,
                        "Todos los grados",
                        new
                        {
                            @class = "form-select",
                            id = "id_grado"
                        })

                </div>

                <div class="historial-filtro">

                    <label for="id_seccion">
                        Sección
                    </label>

                    @Html.DropDownList(
                        "id_seccion",
                        secciones,
                        "Todas las secciones",
                        new
                        {
                            @class = "form-select",
                            id = "id_seccion"
                        })

                    <div id="errorSecciones"
                         class="historial-error"
                         role="alert">

                        No fue posible cargar las secciones.

                    </div>

                </div>

                <div class="historial-filtro">

                    <label for="id_estudiante">
                        Estudiante
                    </label>

                    @Html.DropDownList(
                        "id_estudiante",
                        estudiantes,
                        "Todos los estudiantes",
                        new
                        {
                            @class = "form-select",
                            id = "id_estudiante"
                        })

                </div>

            </div>

            <div class="historial-botones">

                <button type="submit"
                        class="btn btn-primary">

                    Buscar salidas

                </button>

                <a href="@Url.Action("Historial", "SalidasEstudiantes")"
                   class="btn btn-outline-secondary">

                    Limpiar filtros

                </a>

            </div>
        }

    </div>

    <!-- ======================================== -->
    <!-- INFORMACIÓN INSTITUCIONAL -->
    <!-- ======================================== -->

    <div class="historial-informacion">

        <h5>Control y seguridad institucional</h5>

        <p class="mb-0">

            El historial permite consultar la fecha y hora
            de salida, el motivo, la persona que retiró
            al estudiante y el funcionario responsable
            del registro.

            Esta información es de uso institucional
            y debe ser tratada de manera confidencial.

        </p>

    </div>

    <!-- ======================================== -->
    <!-- LISTADO DE SALIDAS -->
    <!-- ======================================== -->

    <div class="historial-panel">

        <h4>Salidas registradas</h4>

        <div class="historial-resultados">

            Resultados encontrados: @totalResultados

        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="historial-vacio">

                <h3>No se encontraron salidas</h3>

                <p>

                    No existen registros de salidas
                    que coincidan con los filtros seleccionados.

                </p>

                <a href="@Url.Action("Registrar", "SalidasEstudiantes")"
                   class="btn btn-success">

                    Registrar salida

                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="historial-tabla">

                    <thead>

                        <tr>

                            <th>Número de registro</th>

                            <th>Estudiante</th>

                            <th>Grado y sección</th>

                            <th>Fecha de salida</th>

                            <th>Hora de salida</th>

                            <th>Motivo</th>

                            <th>Persona que retira</th>

                            <th>Parentesco</th>

                            <th>Teléfono</th>

                            <th>Registrado por</th>

                            <th>Fecha de registro</th>

                            <th>Observaciones</th>

                            <th>Estado</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var salida in Model)
                        {
                            string fechaSalida =
                                salida.fecha_salida.HasValue
                                ? salida.fecha_salida.Value.ToString("dd/MM/yyyy")
                                : "No disponible";

                            string horaSalida =
                                salida.hora_salida.HasValue
                                ? salida.hora_salida.Value.ToString(@"hh\:mm")
                                : "No disponible";

                            string fechaRegistro =
                                salida.fecha_registro.ToString("dd/MM/yyyy");

                            string horaRegistro =
                                salida.fecha_registro.ToString("HH:mm");

                            string telefono =
                                string.IsNullOrWhiteSpace(
                                    salida.telefono_persona_retira)
                                ? "No registrado"
                                : salida.telefono_persona_retira;

                            string observaciones =
                                string.IsNullOrWhiteSpace(
                                    salida.observaciones)
                                ? "Sin observaciones"
                                : salida.observaciones;

                            string claseEstado =
                                "estado-desconocido";

                            if (salida.estado == "Registrada")
                            {
                                claseEstado =
                                    "estado-registrada";
                            }
                            else if (salida.estado == "Anulada")
                            {
                                claseEstado =
                                    "estado-anulada";
                            }

                            <tr>

                                <!-- NÚMERO DE REGISTRO -->

                                <td>

                                    <strong>
                                        #@(salida.id_salida)
                                    </strong>

                                </td>

                                <!-- ESTUDIANTE -->

                                <td class="texto-izquierda">

                                    <strong>

                                        @salida.nombre_estudiante

                                    </strong>

                                    <div class="texto-secundario">

                                        @salida.identificacion_estudiante

                                    </div>

                                </td>

                                <!-- GRADO Y SECCIÓN -->

                                <td>

                                    <strong>

                                        @salida.nombre_grado

                                    </strong>

                                    <div class="texto-secundario">

                                        @salida.nombre_seccion

                                    </div>

                                </td>

                                <!-- FECHA DE SALIDA -->

                                <td>

                                    @fechaSalida

                                </td>

                                <!-- HORA DE SALIDA -->

                                <td>

                                    @horaSalida

                                </td>

                                <!-- MOTIVO -->

                                <td class="historial-motivo">@salida.motivo</td>

                                <!-- PERSONA QUE RETIRA -->

                                <td class="historial-persona texto-izquierda">

                                    <strong>

                                        @salida.nombre_persona_retira

                                    </strong>

                                    <div class="texto-secundario">

                                        Identificación:

                                        @salida.identificacion_persona_retira

                                    </div>

                                </td>

                                <!-- PARENTESCO -->

                                <td>

                                    @salida.parentesco

                                </td>

                                <!-- TELÉFONO -->

                                <td>

                                    @telefono

                                </td>

                                <!-- RESPONSABLE DEL REGISTRO -->

                                <td>

                                    @salida.nombre_registrado_por

                                </td>

                                <!-- FECHA DE REGISTRO -->

                                <td>

                                    <span>

                                        @fechaRegistro

                                    </span>

                                    <div class="texto-secundario">

                                        @horaRegistro

                                    </div>

                                </td>

                                <!-- OBSERVACIONES -->

                                <td class="historial-observaciones">@observaciones</td>

                                <!-- ESTADO -->

                                <td>

                                    <span class="estado-salida @claseEstado">

                                        @salida.estado

                                    </span>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

    <!-- ======================================== -->
    <!-- BOTONES INFERIORES -->
    <!-- ======================================== -->

    <div class="historial-botones">

        <a href="@Url.Action("Registrar", "SalidasEstudiantes")"
           class="btn btn-success">

            Registrar nueva salida

        </a>

        <a href="@Url.Action("Historial", "SalidasEstudiantes")"
           class="btn btn-outline-primary">

            Actualizar historial

        </a>

        <a href="@Url.Action("Index", "Home")"
           class="btn btn-secondary">

            Volver al inicio

        </a>

    </div>

</div>

@section scripts {

    <script>

        $(document).ready(function () {

            var solicitudSecciones = null;

            // ========================================
            // VALIDAR RANGO DE FECHAS
            // ========================================

            $("#formFiltrosSalidas").on(
                "submit",
                function (evento) {

                    var fechaDesde =
                        $("#fecha_desde").val();

                    var fechaHasta =
                        $("#fecha_hasta").val();

                    if (fechaDesde &&
                        fechaHasta &&
                        fechaDesde > fechaHasta) {

                        evento.preventDefault();

                        alert(
                            "La fecha inicial no puede ser mayor que la fecha final."
                        );
                    }

                }
            );

            // ========================================
            // CARGAR SECCIONES SEGÚN EL GRADO
            // ========================================

            $("#id_grado").on("change", function () {

                var idGrado = $(this).val() || 0;

                var comboSecciones =
                    $("#id_seccion");

                var comboEstudiantes =
                    $("#id_estudiante");

                if (solicitudSecciones) {

                    solicitudSecciones.abort();

                    solicitudSecciones = null;
                }

                $("#errorSecciones").hide();

                comboSecciones.empty();

                comboSecciones.append(
                    $("<option>", {
                        value: "",
                        text: "Todas las secciones"
                    })
                );

                comboEstudiantes.empty();

                comboEstudiantes.append(
                    $("<option>", {
                        value: "",
                        text: "Todos los estudiantes"
                    })
                );

                comboSecciones.prop(
                    "disabled",
                    true
                );

                solicitudSecciones = $.ajax({

                    url: '@Url.Action("ObtenerSecciones", "SalidasEstudiantes")',

                    type: "GET",

                    dataType: "json",

                    cache: false,

                    data: {
                        id_grado: idGrado
                    },

                    success: function (respuesta) {

                        if (respuesta) {

                            $.each(
                                respuesta,
                                function (indice, seccion) {

                                    comboSecciones.append(
                                        $("<option>", {
                                            value: seccion.id,
                                            text: seccion.nombre
                                        })
                                    );
                                }
                            );
                        }
                    },

                    error: function (xhr, estado) {

                        if (estado === "abort") {

                            return;
                        }

                        $("#errorSecciones").show();
                    },

                    complete: function () {

                        comboSecciones.prop(
                            "disabled",
                            false
                        );

                        solicitudSecciones = null;
                    }

                });

            });

            // ========================================
            // ACTUALIZAR ESTUDIANTES SEGÚN FILTROS
            // ========================================

            $("#id_seccion").on("change", function () {

                $("#id_estudiante").val("");

                $("#formFiltrosSalidas").trigger("submit");

            });

        });

    </script>

}