@model EduNexus.Abstracciones.ModelosParaUI.Horarios.HorarioConsultaDto

@{
    ViewBag.Title = "Horario semanal";
}

<h2>Horario semanal - @Model.titulo</h2>

@if (!string.IsNullOrEmpty(Model.mensaje))
{
    <div class="alert alert-warning">
        @Model.mensaje
        @Html.ActionLink("Crear horario", "CrearHorario", new { id = Model.id_seccion }, new { @class = "btn btn-primary btn-sm ms-2" })
    </div>
}
else
{
    @Html.Partial("_HorarioSemanal", Model.items, new ViewDataDictionary { { "mostrarProfesor", true } })
}

<div class="mt-3">
    @Html.ActionLink("Regresar", "ListadoDeHorarios", new { id = Model.id_seccion })
</div>