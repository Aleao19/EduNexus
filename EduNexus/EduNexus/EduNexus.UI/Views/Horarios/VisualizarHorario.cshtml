@{
    ViewBag.Title = "Horario semanal";
}

<h2>Horario semanal - Sección 1-A</h2>

<style>
    .calendario {
        border-collapse: collapse;
        width: 100%;
        table-layout: fixed;
    }

        .calendario th {
            background-color: #17a2b8;
            color: #fff;
            padding: 10px;
            text-align: center;
            border: 1px solid #dee2e6;
        }

        .calendario td {
            border: 1px solid #dee2e6;
            padding: 0;
            vertical-align: top;
            height: 60px;
        }

        .calendario .hora-col {
            background-color: #f8f9fa;
            font-weight: bold;
            text-align: center;
            vertical-align: middle;
            width: 110px;
        }

    .bloque {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        font-weight: 600;
        border-radius: 4px;
        margin: 2px;
        padding: 4px;
    }

    .bloque-materia {
        background-color: #cfe8ff;
        color: #084298;
    }

    .bloque-receso {
        background-color: #fff3cd;
        color: #664d03;
    }
</style>

<table class="calendario">
    <thead>
        <tr>
            <th class="hora-col">Hora</th>
            <th>Lunes</th>
            <th>Martes</th>
            <th>Miércoles</th>
            <th>Jueves</th>
            <th>Viernes</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td class="hora-col">07:00 - 09:00</td>
            <td><div class="bloque bloque-materia">Matemáticas</div></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td class="hora-col">09:00 - 09:30</td>
            <td><div class="bloque bloque-receso">Receso</div></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td class="hora-col">09:30 - 11:30</td>
            <td><div class="bloque bloque-materia">Español</div></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
        </tr>
    </tbody>
</table>

<div class="mt-3">
    @Html.ActionLink("Regresar", "ListadoDeHorarios", new { id = 1 })
</div>