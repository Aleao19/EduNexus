@model EduNexus.Abstracciones.ModelosParaUI.Horarios.HorarioConsultaDto

@{
    ViewBag.Title = "Horario semanal";
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Académico</div>
            <h2 class="page-title">Horario semanal - @Model.titulo</h2>
            <div class="page-subtitle">Distribución de las clases de la sección de lunes a viernes.</div>
        </div>
        <div class="col-12 col-md-auto ms-auto">
            <div class="btn-list">
                @Html.ActionLink("Regresar", "ListadoDeHorarios", new { id = Model.id_seccion }, new { @class = "btn btn-outline-secondary" })
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.mensaje))
{
    <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2">
        <span>@Model.mensaje</span>
        @Html.ActionLink("Crear horario", "CrearHorario", new { id = Model.id_seccion }, new { @class = "btn btn-primary btn-sm ms-auto" })
    </div>
}
else
{
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Horario semanal</h3>
        </div>
        @Html.Partial("_HorarioSemanal", Model.items, new ViewDataDictionary { { "mostrarProfesor", true } })
    </div>
}
