@model EduNexus.Abstracciones.ModelosParaUI.Horarios.HorarioConsultaDto

@{
    ViewBag.Title = "Horarios";

    // Ventana de hasta 5 números de página alrededor de la actual
    int hasta = Math.Min(Model.totalPaginas, Math.Max(1, Model.pagina - 2) + 4);
    int desde = Math.Max(1, hasta - 4);
    int primero = Model.totalRegistros == 0 ? 0 : (Model.pagina - 1) * Model.tamanoPagina + 1;
    int ultimo = Math.Min(Model.pagina * Model.tamanoPagina, Model.totalRegistros);

    // Enlaces de paginación que conservan la búsqueda y los filtros
    Func<int, string> enlacePagina = p =>
        Url.Content("~/Horarios/ListadoDeHorarios")
        + "?id=" + Model.id_seccion
        + "&docente=" + Url.Encode(Model.id_docente)
        + "&q=" + Url.Encode(Model.q)
        + "&pagina=" + p;
}

<div class="row align-items-center mb-3">
    <div class="col">
        <h1 class="mb-0">Horarios</h1>
        <p class="text-secondary mb-0">Busque o filtre los horarios por sección y por docente.</p>
    </div>
    @if (Model.id_seccion.HasValue)
    {
        <div class="col-auto">
            @Html.ActionLink("Ver semana", "VisualizarHorario", new { id = Model.id_seccion }, new { @class = "btn btn-outline-secondary me-1" })
            @Html.ActionLink("Asignar estudiantes", "HorarioParaAsignacion", new { id = Model.id_seccion }, new { @class = "btn btn-outline-secondary me-1" })
            @Html.ActionLink("+ Nuevo horario", "CrearHorario", new { id = Model.id_seccion }, new { @class = "btn btn-primary" })
        </div>
    }
</div>

<form method="get" action="@Url.Content("~/Horarios/ListadoDeHorarios")" class="row g-2 align-items-end mb-3">
    <div class="col-md-4">
        <label class="form-label" for="buscarHorario">Buscar</label>
        <div class="hs-buscador">
            <input type="text" id="buscarHorario" name="q" value="@Model.q" class="form-control" autocomplete="off"
                   placeholder="Materia, docente, sección o día..."
                   data-url="@Url.Content("~/Horarios/SugerenciasHorarios")" />
            <div id="sugerenciasHorario" class="list-group hs-sugerencias"></div>
        </div>
    </div>
    <div class="col-md-3">
        <label class="form-label" for="id">Sección</label>
        @Html.DropDownList("id", (SelectList)ViewBag.Secciones, "Todas las secciones", new { @class = "form-select" })
    </div>
    <div class="col-md-3">
        <label class="form-label" for="docente">Docente</label>
        @Html.DropDownList("docente", (SelectList)ViewBag.Docentes, "Todos los docentes", new { @class = "form-select" })
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-cyan">Consultar</button>
        <a href="@Url.Content("~/Horarios/ListadoDeHorarios")" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

@if (!string.IsNullOrEmpty(Model.mensaje))
{
    <div class="alert alert-warning">@Model.mensaje</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>Día</th>
                        <th>Hora</th>
                        <th>Materia</th>
                        <th>Docente</th>
                        <th>Sección</th>
                        <th class="w-1">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.items)
                    {
                        <tr>
                            <td>@item.dia_semana</td>
                            <td>@item.inicio - @item.fin</td>
                            <td>@item.materia</td>
                            <td>@item.profesor</td>
                            <td>@item.seccion</td>
                            <td class="text-nowrap">
                                @Html.ActionLink("Editar", "EditarHorario", new { id = item.id_horario }, new { @class = "btn btn-sm btn-outline-secondary" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer d-flex align-items-center">
            <p class="m-0 text-secondary">
                Mostrando <strong>@primero</strong> a <strong>@ultimo</strong> de <strong>@Model.totalRegistros</strong> horarios
            </p>

            @if (Model.totalPaginas > 1)
            {
                <ul class="pagination m-0 ms-auto">
                    <li class="page-item @(Model.pagina == 1 ? "disabled" : "")">
                        <a class="page-link" href="@enlacePagina(Model.pagina - 1)">Anterior</a>
                    </li>

                    @for (int p = desde; p <= hasta; p++)
                    {
                        <li class="page-item @(p == Model.pagina ? "active" : "")">
                            <a class="page-link" href="@enlacePagina(p)">@p</a>
                        </li>
                    }

                    <li class="page-item @(Model.pagina == Model.totalPaginas ? "disabled" : "")">
                        <a class="page-link" href="@enlacePagina(Model.pagina + 1)">Siguiente</a>
                    </li>
                </ul>
            }
        </div>
    </div>
}

@section Scripts {
    <script src="@Url.Content("~/Scripts/Horarios/ListadoDeHorarios.js")"></script>
}