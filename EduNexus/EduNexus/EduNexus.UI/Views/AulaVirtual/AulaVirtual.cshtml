@model IEnumerable<EduNexus.Abstracciones.ModelosParaUI.Materias.MateriasDto>

@{
    ViewBag.Title = "Aula Virtual";
    string[] colores = { "blue", "green", "purple", "orange", "teal", "red", "yellow", "azure" };
}

<div class="row align-items-center mb-3">
    <div class="col">
        <h1 class="mb-0">Aula Virtual</h1>
        <p class="text-secondary mb-0">Selecciona una materia para gestionar asignaciones, notas y asistencia.</p>
    </div>
    <div class="col-auto">
        <input type="text" id="buscarMateria" class="form-control" placeholder="Buscar materia..." onkeyup="filtrarMaterias()" />
    </div>
</div>

<div class="container-xl p-0">
    <div class="row row-cards g-4" id="gridMaterias">
        @if (Model != null && Model.Any())
        {
            int i = 0;
            foreach (var materia in Model)
            {
                string color = colores[i % colores.Length];
                bool sinProfesor = string.IsNullOrEmpty(materia.profesor);
                i++;
                <div class="col-sm-6 col-lg-4 col-xl-3 tarjeta-materia" data-nombre="@materia.nombre.ToLower()">
                    <div class="card d-flex flex-column h-100 shadow-sm" style="border-top: 3px solid var(--tblr-@(color))">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="badge bg-@(color)-lt">Materia</span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon text-secondary">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                    <path d="M3 19a9 9 0 0 1 9 0a9 9 0 0 1 9 0" />
                                    <path d="M3 6a9 9 0 0 1 9 0a9 9 0 0 1 9 0" />
                                    <path d="M3 6v13" />
                                    <path d="M12 6v13" />
                                    <path d="M21 6v13" />
                                </svg>
                            </div>

                            <h3 class="card-title mt-2 mb-1">
                                <a href="@Url.Action("Materia", "AulaVirtual", new { id = materia.id_materia })" class="text-body">
                                    @materia.nombre
                                </a>
                            </h3>

                            <div class="text-secondary small mb-3">Sección: 3-B</div>

                            <div class="d-flex align-items-center pt-2 mt-auto border-top">
                                <span class="avatar avatar-sm rounded-circle @(sinProfesor ? "bg-red-lt" : "bg-" + color + "-lt") fw-bold">
                                    @(sinProfesor ? "?" : materia.profesor.Substring(0, 1).ToUpper())
                                </span>

                                <div class="ms-2 flex-fill">
                                    <div class="text-body fw-medium small">
                                        @(sinProfesor ? "Sin profesor asignado" : materia.profesor)
                                    </div>
                                    <div class="text-secondary small">Profesor titular</div>
                                </div>

                                <a href="@Url.Action("Materia", "AulaVirtual", new { id = materia.id_materia })" class="btn btn-sm btn-icon btn-ghost-secondary" title="Entrar al aula">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                        <path d="M5 12l14 0" />
                                        <path d="M13 18l6 -6" />
                                        <path d="M13 6l6 6" />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="empty">
                            <p class="empty-title">No hay materias registradas</p>
                            <p class="empty-subtitle text-secondary">Cuando se asignen materias aparecerán aquí.</p>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    <div id="sinResultados" class="col-12 mt-3" style="display:none">
        <div class="alert alert-info">No se encontraron materias con ese nombre.</div>
    </div>
</div>

