@model IEnumerable<EduNexus.Abstracciones.ModelosParaUI.Asignaciones.AsignacionesDto>

@{
    ViewBag.Title = "Materia";
}

<h2>Materia</h2>

<hr />

<div class="accordion" id="materiaAccordion">

    <!-- ASIGNACIONES -->
    <div class="accordion-item">
        <h2 class="accordion-header" id="heading-asignaciones">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-asignaciones" aria-expanded="true" aria-controls="collapse-asignaciones">
                Asignaciones
            </button>
        </h2>
        <div id="collapse-asignaciones" class="accordion-collapse collapse show" aria-labelledby="heading-asignaciones" data-bs-parent="#materiaAccordion">
            <div class="accordion-body">
                <div class="row row-cards">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var asignacion in Model)
                        {
                            // Código C# directo sin necesidad de @{
                            string badgeClass;
                            string estadoTexto;

                            switch (asignacion.estado?.ToLower())
                            {
                                case "entregado":
                                case "entregada":
                                    badgeClass = "bg-success-lt text-success";
                                    estadoTexto = "Entregada";
                                    break;
                                case "pendiente":
                                    badgeClass = "bg-warning-lt text-warning";
                                    estadoTexto = "Pendiente";
                                    break;
                                case "atrasado":
                                case "atrasada":
                                    badgeClass = "bg-danger-lt text-danger";
                                    estadoTexto = "Atrasada";
                                    break;
                                case "calificado":
                                case "calificada":
                                    badgeClass = "bg-info-lt text-info";
                                    estadoTexto = "Calificada";
                                    break;
                                default:
                                    badgeClass = "bg-secondary-lt text-secondary";
                                    estadoTexto = string.IsNullOrEmpty(asignacion.estado) ? "Sin Estado" : asignacion.estado;
                                    break;
                            }
                            <div class="row justify-content-md-center">
                                <div class="col-8 my-3">
                                    <div class="card card-md shadow-sm">
                                        <div class="card-body">
                                            <div class="row align-items-center g-3">

                                                <!-- 1. Información Principal -->
                                                <div class="col-md-5 col-12">
                                                    <div class="d-flex align-items-center mb-2 gap-2">
                                                        <h3 class="card-title mb-0 fs-3">
                                                            <a href="@Url.Action("Detalles", "Asignaciones", new { id = asignacion.id_asignacion })" class="text-reset text-decoration-none">
                                                                @asignacion.nombre
                                                            </a>
                                                        </h3>
                                                        <span class="badge @badgeClass fw-semibold">
                                                            @estadoTexto
                                                        </span>
                                                    </div>
                                                    <p class="text-secondary mb-0 small" style="max-height: 2.8rem; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                                        @(string.IsNullOrWhiteSpace(asignacion.descripcion) ? "Sin descripción disponible para esta asignación." : asignacion.descripcion)
                                                    </p>
                                                </div>
                                                
                                                <!-- 2. Bloque de Fechas -->
                                                <div class="col-md-4 col-sm-7 col-12 border-start-md px-md-4">
                                                    <div class="row g-2 text-secondary small">
                                                        <div class="col-6">
                                                            <span class="d-block text-muted text-uppercase fs-6 fw-bold">Apertura</span>
                                                            <span class="fw-medium text-body">
                                                                @asignacion.fechaDeApertura.ToString("dd MMM yyyy, HH:mm")
                                                            </span>
                                                        </div>
                                                        <div class="col-6">
                                                            <span class="d-block text-muted text-uppercase fs-6 fw-bold">Cierre</span>
                                                            <span class="fw-medium text-body">
                                                                @asignacion.fechaDeCierre.ToString("dd MMM yyyy, HH:mm")
                                                            </span>
                                                        </div>
                                                        <div class="col-12 mt-2 pt-1 border-top">
                                                            <span class="text-muted">Fecha de Entrega: </span>
                                                            <span class="fw-medium text-body">
                                                                @(asignacion.fechaDeEntrega == DateTime.MinValue
                                                                ? "Aún no entregado"
                                                                : asignacion.fechaDeEntrega.ToString("dd MMM yyyy, HH:mm"))
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                                
                                                 <!-- 3. Porcentaje, Calificación y Acción -->
                                                <div class="col-md-3 col-sm-5 col-12 border-start-md text-sm-end text-start">
                                                    <div class="d-flex flex-column align-items-sm-end align-items-start">
                                                        <div class="mb-1">
                                                            <span class="text-secondary small me-1">Porcentaje:</span>
                                                            <span class="badge bg-blue-lt fw-bold">@asignacion.porcentaje_nota%</span>
                                                        </div>

                                                        <div class="h2 mb-2 fw-bold text-primary">
                                                            @asignacion.calificacion.ToString("0.0")
                                                            <span class="fs-6 text-muted fw-normal">/ 100</span>
                                                        </div>

                                                        <a href="@Url.Action("Entregar", "Asignaciones", new { id = asignacion.id_asignacion })" class="btn btn-cyan btn-sm">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon me-1">
                                                                <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2"></path>
                                                                <path d="M7 9l5 -5l5 5"></path>
                                                                <path d="M12 4l0 12"></path>
                                                            </svg>
                                                            Ver / Entregar
                                                        </a>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12">
                            <div class="alert alert-info d-flex align-items-center" role="alert">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon me-2">
                                    <circle cx="12" cy="12" r="9"></circle>
                                    <line x1="12" y1="8" x2="12" y2="12"></line>
                                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                </svg>
                                <div>No hay asignaciones registradas para mostrar.</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ASISTENCIA -->
    <div class="accordion-item">
        <h2 class="accordion-header" id="heading-asistencia">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-asistencia" aria-expanded="false" aria-controls="collapse-asistencia">
                Asistencia
            </button>
        </h2>
        <div id="collapse-asistencia" class="accordion-collapse collapse" aria-labelledby="heading-asistencia" data-bs-parent="#materiaAccordion">
            <div class="accordion-body">
                @{
                    var estudiantes = (List<string>)ViewBag.Estudiantes;
                }
                @using (Html.BeginForm("GuardarAsistencia", "AulaVirtual", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Fecha</label>
                            <input type="date" name="fecha" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>

                    <table class="table table-responsive">
                        <thead>
                            <tr>
                                <th>Estudiante</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < estudiantes.Count; i++)
                            {
                                <tr>
                                    <td>@estudiantes[i]</td>
                                    <td>
                                        <select name="asistencia_@i" class="form-control">
                                            <option value="Presente">Presente</option>
                                            <option value="Ausente">Ausente</option>
                                            <option value="Justificado">Justificado</option>
                                            <option value="Tardía">Tardía</option>
                                        </select>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <button type="submit" class="btn btn-cyan">Guardar cambios</button>
                }
            </div>
        </div>
    </div>

