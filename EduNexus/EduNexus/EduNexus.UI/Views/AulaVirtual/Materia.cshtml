@model IEnumerable<EduNexus.Abstracciones.ModelosParaUI.Asignaciones.AsignacionesDto>

@{
    string nombreMateria = ViewBag.NombreMateria as string ?? "Materia";
    string nombreSeccion = ViewBag.NombreSeccion as string ?? "";
    ViewBag.Title = "Aula Virtual - " + nombreMateria;

    bool esDocente = ViewBag.EsDocente == true;
    bool esEstudiante = ViewBag.EsEstudiante == true;
    var estudiantes = (ViewBag.Estudiantes as List<string>) ?? new List<string>();
    var estudiantePorAsignacion = (ViewBag.EstudiantePorAsignacion as Dictionary<int, string>) ?? new Dictionary<int, string>();
    var asignaciones = (Model ?? new List<EduNexus.Abstracciones.ModelosParaUI.Asignaciones.AsignacionesDto>()).ToList();

    int totalAsignaciones = asignaciones.Count;
    int pendientes = asignaciones.Count(a => (a.estado ?? "").ToLower() == "pendiente");
    int entregadas = asignaciones.Count(a => (a.estado ?? "").ToLower().StartsWith("entreg"));
    double promedio = asignaciones.Any(a => a.calificacion > 0) ? asignaciones.Where(a => a.calificacion > 0).Average(a => a.calificacion) : 0;
}

<div class="row align-items-center mb-3">
    <div class="col">
        <div class="text-secondary small mb-1">
            @Html.ActionLink("Aula Virtual", "AulaVirtual", "AulaVirtual") / @nombreMateria
        </div>
        <h1 class="mb-0">@nombreMateria</h1>
        <p class="text-secondary mb-0">@nombreSeccion</p>
    </div>
</div>

@* ===================== KPIs ===================== *@
<div class="row row-cards g-3 mb-3">
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">@(esEstudiante ? "Mi promedio" : "Promedio de la clase")</div>
                <div class="h2 mb-0">@(asignaciones.Any(a => a.calificacion > 0) ? promedio.ToString("0.0") : "—")</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">Asignaciones pendientes</div>
                <div class="h2 mb-0 @(pendientes > 0 ? "text-warning" : "")">@pendientes</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">Entregadas</div>
                <div class="h2 mb-0 text-success">@entregadas / @totalAsignaciones</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">Estudiantes de la sección</div>
                <div class="h2 mb-0">@estudiantes.Count</div>
            </div>
        </div>
    </div>
</div>

@* ===================== TABS ===================== *@
<ul class="nav nav-tabs mb-3" id="materiaTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="tab-asignaciones-btn" data-bs-toggle="tab" data-bs-target="#tab-asignaciones" type="button" role="tab">
            Asignaciones
            @if (pendientes > 0)
            {
                <span class="badge bg-warning-lt ms-1">@pendientes</span>
            }
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-estudiantes-btn" data-bs-toggle="tab" data-bs-target="#tab-estudiantes" type="button" role="tab">
            Estudiantes
            <span class="badge bg-blue-lt ms-1">@estudiantes.Count</span>
        </button>
    </li>
    @if (esDocente)
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-asistencia-btn" data-bs-toggle="tab" data-bs-target="#tab-asistencia" type="button" role="tab">
                Asistencia
            </button>
        </li>
    }
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-material-btn" data-bs-toggle="tab" data-bs-target="#tab-material" type="button" role="tab">
            Material y comunicados
        </button>
    </li>
</ul>

<div class="tab-content">

    @* ===================== TAB: ASIGNACIONES (solo lectura) ===================== *@
    <div class="tab-pane fade show active" id="tab-asignaciones" role="tabpanel">

        @if (asignaciones.Any())
        {
            <div class="btn-group mb-3" role="group" aria-label="Filtrar asignaciones" id="filtrosAsignaciones">
                <button type="button" class="btn btn-sm btn-outline-secondary active" data-filtro="todas">Todas</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-filtro="pendiente">Pendientes</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-filtro="entreg">Entregadas</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-filtro="calificad">Calificadas</button>
            </div>
        }

        <div class="row row-cards" id="listaAsignaciones">
            @if (asignaciones.Any())
            {
                foreach (var asignacion in asignaciones)
                {
                    string badgeClass;
                    string estadoTexto;
                    string estadoFiltro = (asignacion.estado ?? "").Trim().ToLower();
                    string estudiante;
                    estudiantePorAsignacion.TryGetValue(asignacion.id_asignacion, out estudiante);

                    switch (estadoFiltro)
                    {
                        case "entregado":
                        case "entregada":
                            badgeClass = "bg-success-lt text-success";
                            estadoTexto = "Entregada";
                            break;
                        case "pendiente":
                            badgeClass = "bg-warning-lt text-warning";
                            estadoTexto = "Pendiente";
                            break;
                        case "atrasado":
                        case "atrasada":
                            badgeClass = "bg-danger-lt text-danger";
                            estadoTexto = "Atrasada";
                            break;
                        case "calificado":
                        case "calificada":
                            badgeClass = "bg-info-lt text-info";
                            estadoTexto = "Calificada";
                            break;
                        default:
                            badgeClass = "bg-secondary-lt text-secondary";
                            estadoTexto = string.IsNullOrEmpty(asignacion.estado) ? "Sin estado" : asignacion.estado;
                            break;
                    }

                    <div class="col-12 tarjeta-asignacion" data-estado="@estadoFiltro">
                        <div class="card shadow-sm mb-3">
                            <div class="card-body">
                                <div class="row align-items-center g-3">
                                    <div class="col-md-8 col-12">
                                        <div class="d-flex align-items-center mb-2 gap-2 flex-wrap">
                                            <h3 class="card-title mb-0 fs-3">@asignacion.nombre</h3>
                                            <span class="badge @badgeClass fw-semibold">@estadoTexto</span>
                                        </div>
                                        @if (!esEstudiante && !string.IsNullOrEmpty(estudiante))
                                        {
                                            <div class="text-secondary small mb-1">Estudiante: <span class="text-body fw-medium">@estudiante</span></div>
                                        }
                                        <p class="text-secondary mb-0 small">
                                            @(string.IsNullOrWhiteSpace(asignacion.descripcion) ? "Sin descripción." : asignacion.descripcion)
                                        </p>
                                    </div>
                                    <div class="col-md-4 col-12 text-md-end">
                                        <div class="mb-1">
                                            <span class="text-secondary small me-1">Porcentaje:</span>
                                            <span class="badge bg-blue-lt fw-bold">@asignacion.porcentaje_nota.ToString("0.##")%</span>
                                        </div>
                                        <div class="h2 mb-0 fw-bold text-primary">
                                            @asignacion.calificacion.ToString("0.0")
                                            <span class="fs-6 text-muted fw-normal">/ 100</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <div class="empty">
                                <p class="empty-title">No hay asignaciones registradas</p>
                                <p class="empty-subtitle text-secondary">Todavía no hay asignaciones registradas para esta clase.</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div id="sinResultadosAsignaciones" class="alert alert-info" style="display:none">
            No hay asignaciones que coincidan con este filtro.
        </div>
    </div>

    @* ===================== TAB: ESTUDIANTES ===================== *@
    <div class="tab-pane fade" id="tab-estudiantes" role="tabpanel">
        <div class="card shadow-sm">
            @if (estudiantes.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var nombre in estudiantes)
                    {
                        string inicial = string.IsNullOrWhiteSpace(nombre) ? "?" : nombre.Trim().Substring(0, 1).ToUpper();
                        <div class="list-group-item d-flex align-items-center">
                            <span class="avatar avatar-sm rounded-circle bg-blue-lt fw-bold me-3">@inicial</span>
                            <div class="fw-medium">@nombre</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card-body">
                    <div class="empty">
                        <p class="empty-title">La sección no tiene estudiantes asignados</p>
                    </div>
                </div>
            }
        </div>
    </div>

    @* ===================== TAB: ASISTENCIA (solo docente) ===================== *@
    @if (esDocente)
    {
        <div class="tab-pane fade" id="tab-asistencia" role="tabpanel">
            <div id="contenedorAsistencia"
                 data-url-lista="@Url.Action("Lista", "Asistencia")"
                 data-clase="@(ViewBag.IdSeccion + "-" + ViewBag.IdMateria)">

                <div class="card shadow-sm mb-3">
                    <div class="card-body d-flex align-items-end flex-wrap gap-3">
                        <div>
                            <label class="form-label" for="asistFecha">Fecha</label>
                            <input type="date" id="asistFecha" class="form-control"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <button type="button" id="btnCargarAsistencia" class="btn btn-cyan">Cargar lista</button>
                    </div>
                </div>

                <div id="listaAsistencia"></div>
            </div>
        </div>
    }

    @* ===================== TAB: MATERIAL Y COMUNICADOS ===================== *@
    <div class="tab-pane fade" id="tab-material" role="tabpanel">
        <div class="row g-3">
            <div class="col-lg-7">
                <div class="card shadow-sm">
                    <div class="card-header">
                        <h3 class="card-title mb-0">Material publicado</h3>
                    </div>
                    <div class="card-body">
                        <div class="empty">
                            <p class="empty-title">Todavía no hay materiales publicados</p>
                            <p class="empty-subtitle text-secondary">La publicación de material aún no está disponible en el sistema.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card shadow-sm">
                    <div class="card-header">
                        <h3 class="card-title mb-0">Comunicados</h3>
                    </div>
                    <div class="card-body">
                        <div class="empty">
                            <p class="empty-title">Todavía no hay comunicados</p>
                            <p class="empty-subtitle text-secondary">La publicación de comunicados aún no está disponible en el sistema.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section scripts {
    @if (esDocente)
    {
        <script src="@Url.Content("~/Scripts/Asistencia/ListaAsistencia.js")"></script>
    }
    <script>
        (function () {
            var grupo = document.getElementById('filtrosAsignaciones');
            if (!grupo) { return; }
            grupo.querySelectorAll('button[data-filtro]').forEach(function (boton) {
                boton.addEventListener('click', function () {
                    var filtro = boton.getAttribute('data-filtro');
                    grupo.querySelectorAll('button').forEach(function (b) { b.classList.remove('active'); });
                    boton.classList.add('active');
                    var visibles = 0;
                    document.querySelectorAll('.tarjeta-asignacion').forEach(function (t) {
                        var estado = t.getAttribute('data-estado') || '';
                        var mostrar = filtro === 'todas' || estado.indexOf(filtro) === 0;
                        t.style.display = mostrar ? '' : 'none';
                        if (mostrar) { visibles++; }
                    });
                    document.getElementById('sinResultadosAsignaciones').style.display = visibles === 0 ? '' : 'none';
                });
            });
        })();
    </script>
}
