@model IEnumerable<EduNexus.Abstracciones.ModelosParaUI.Asignaciones.AsignacionesDto>

@{
    ViewBag.Title = "Aula Virtual - Materia";

    var estudiantes = (ViewBag.Estudiantes as List<string>) ?? new List<string>();
    var asignaciones = Model ?? new List<EduNexus.Abstracciones.ModelosParaUI.Asignaciones.AsignacionesDto>();

    int totalAsignaciones = asignaciones.Count();
    int pendientes = asignaciones.Count(a => (a.estado ?? "").ToLower() == "pendiente");
    int entregadas = asignaciones.Count(a => (a.estado ?? "").ToLower().StartsWith("entreg"));
    double promedio = asignaciones.Any(a => a.calificacion > 0) ? asignaciones.Where(a => a.calificacion > 0).Average(a => a.calificacion) : 0;

    // TODO: reemplazar por datos reales provenientes del controlador (materiales publicados y comunicados de la materia)
    var materiales = new List<(string Nombre, string Tipo, string Fecha, string Url)>
{
        ("Guía de práctica - Unidad 3", "PDF", DateTime.Now.AddDays(-3).ToString("dd/MM/yyyy"), "#"),
        ("Video explicativo: fracciones", "Enlace", DateTime.Now.AddDays(-6).ToString("dd/MM/yyyy"), "#"),
        ("Presentación clase 5", "PPTX", DateTime.Now.AddDays(-10).ToString("dd/MM/yyyy"), "#")
    };

    // TODO: reemplazar por datos reales provenientes del controlador (comunicados/recordatorios de la materia)
    var comunicados = new List<(string Titulo, string Mensaje, string Fecha, string Autor)>
{
        ("Recordatorio: entrega de Tarea 3", "No olviden subir su tarea antes del viernes a las 11:59 pm.", DateTime.Now.AddDays(-1).ToString("dd/MM/yyyy"), "Prof. Titular"),
        ("Cambio de aula para la próxima clase", "La clase del jueves será en el laboratorio de cómputo.", DateTime.Now.AddDays(-4).ToString("dd/MM/yyyy"), "Prof. Titular")
    };
}

<div class="row align-items-center mb-3">
    <div class="col">
        <div class="text-secondary small mb-1">
            @Html.ActionLink("Aula Virtual", "AulaVirtual", "AulaVirtual") / Materia
        </div>
        <h1 class="mb-0">@ViewBag.Title</h1>
        <p class="text-secondary mb-0">Asignaciones, asistencia, material y comunicados de la sección.</p>
    </div>
</div>

@* ===================== KPIs ===================== *@
<div class="row row-cards g-3 mb-3">
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">Promedio de la sección</div>
                <div class="h2 mb-0">@promedio.ToString("0.0")</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">Asignaciones pendientes</div>
                <div class="h2 mb-0 @(pendientes > 0 ? "text-warning" : "")">@pendientes</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">Entregadas</div>
                <div class="h2 mb-0 text-success">@entregadas / @totalAsignaciones</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">Asistencia de hoy</div>
                <div class="h2 mb-0" id="kpiAsistenciaHoy">@estudiantes.Count / @estudiantes.Count</div>
            </div>
        </div>
    </div>
</div>

@* ===================== TABS ===================== *@
<ul class="nav nav-tabs mb-3" id="materiaTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="tab-asignaciones-btn" data-bs-toggle="tab" data-bs-target="#tab-asignaciones" type="button" role="tab">
            Asignaciones
            @if (pendientes > 0)
            {
                <span class="badge bg-warning-lt ms-1">@pendientes</span>
            }
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-asistencia-btn" data-bs-toggle="tab" data-bs-target="#tab-asistencia" type="button" role="tab">
            Asistencia
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-material-btn" data-bs-toggle="tab" data-bs-target="#tab-material" type="button" role="tab">
            Material y comunicados
            @if (comunicados.Any())
            {
                <span class="badge bg-blue-lt ms-1">@comunicados.Count</span>
            }
        </button>
    </li>
</ul>

<div class="tab-content">

    @* ===================== TAB: ASIGNACIONES ===================== *@
    <div class="tab-pane fade show active" id="tab-asignaciones" role="tabpanel">

        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <div class="btn-group" role="group" aria-label="Filtrar asignaciones">
                <button type="button" class="btn btn-sm btn-outline-secondary active" data-filtro="todas">Todas</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-filtro="pendiente">Pendientes</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-filtro="entreg">Entregadas</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-filtro="calificad">Calificadas</button>
            </div>
            <a href="@Url.Action("CrearAsignacion", "Asignaciones")" class="btn btn-primary btn-sm">+ Nueva asignación</a>
        </div>

        <div class="row row-cards" id="listaAsignaciones">
            @if (asignaciones.Any())
            {
                foreach (var asignacion in asignaciones)
                {
                    string badgeClass;
                    string estadoTexto;
                    string estadoFiltro = (asignacion.estado ?? "").ToLower();

                    switch (estadoFiltro)
                    {
                        case "entregado":
                        case "entregada":
                            badgeClass = "bg-success-lt text-success";
                            estadoTexto = "Entregada";
                            break;
                        case "pendiente":
                            badgeClass = "bg-warning-lt text-warning";
                            estadoTexto = "Pendiente";
                            break;
                        case "atrasado":
                        case "atrasada":
                            badgeClass = "bg-danger-lt text-danger";
                            estadoTexto = "Atrasada";
                            break;
                        case "calificado":
                        case "calificada":
                            badgeClass = "bg-info-lt text-info";
                            estadoTexto = "Calificada";
                            break;
                        default:
                            badgeClass = "bg-secondary-lt text-secondary";
                            estadoTexto = string.IsNullOrEmpty(asignacion.estado) ? "Sin estado" : asignacion.estado;
                            break;
                    }

                    <div class="col-12 tarjeta-asignacion" data-estado="@estadoFiltro">
                        <div class="card card-md shadow-sm mb-3">
                            <div class="card-body">
                                <div class="row align-items-center g-3">

                                    <!-- Información principal -->
                                    <div class="col-md-5 col-12">
                                        <div class="d-flex align-items-center mb-2 gap-2">
                                            <h3 class="card-title mb-0 fs-3">
                                                <a href="@Url.Action("Detalles", "Asignaciones", new { id = asignacion.id_asignacion })" class="text-reset text-decoration-none">
                                                    @asignacion.nombre
                                                </a>
                                            </h3>
                                            <span class="badge @badgeClass fw-semibold">@estadoTexto</span>
                                        </div>
                                        <p class="text-secondary mb-0 small" style="max-height: 2.8rem; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                            @(string.IsNullOrWhiteSpace(asignacion.descripcion) ? "Sin descripción disponible para esta asignación." : asignacion.descripcion)
                                        </p>
                                    </div>

                                    <!-- Fechas -->
                                    <div class="col-md-4 col-sm-7 col-12 border-start-md px-md-4">
                                        <div class="row g-2 text-secondary small">
                                            <div class="col-6">
                                                <span class="d-block text-muted text-uppercase fs-6 fw-bold">Apertura</span>
                                                <span class="fw-medium text-body">@asignacion.fechaDeApertura.ToString("dd MMM yyyy, HH:mm")</span>
                                            </div>
                                            <div class="col-6">
                                                <span class="d-block text-muted text-uppercase fs-6 fw-bold">Cierre</span>
                                                <span class="fw-medium text-body">@asignacion.fechaDeCierre.ToString("dd MMM yyyy, HH:mm")</span>
                                            </div>
                                            <div class="col-12 mt-2 pt-1 border-top">
                                                <span class="text-muted">Fecha de entrega: </span>
                                                <span class="fw-medium text-body">
                                                    @(asignacion.fechaDeEntrega == DateTime.MinValue ? "Aún no entregado" : asignacion.fechaDeEntrega.ToString("dd MMM yyyy, HH:mm"))
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Porcentaje, calificación y acción -->
                                    <div class="col-md-3 col-sm-5 col-12 border-start-md text-sm-end text-start">
                                        <div class="d-flex flex-column align-items-sm-end align-items-start">
                                            <div class="mb-1">
                                                <span class="text-secondary small me-1">Porcentaje:</span>
                                                <span class="badge bg-blue-lt fw-bold">@asignacion.porcentaje_nota%</span>
                                            </div>
                                            <div class="h2 mb-2 fw-bold text-primary">
                                                @asignacion.calificacion.ToString("0.0")
                                                <span class="fs-6 text-muted fw-normal">/ 100</span>
                                            </div>
                                            <a href="@Url.Action("Entregar", "Asignaciones", new { id = asignacion.id_asignacion })" class="btn btn-cyan btn-sm">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon me-1">
                                                    <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2"></path>
                                                    <path d="M7 9l5 -5l5 5"></path>
                                                    <path d="M12 4l0 12"></path>
                                                </svg>
                                                Ver / Entregar
                                            </a>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <div class="empty">
                                <p class="empty-title">No hay asignaciones registradas</p>
                                <p class="empty-subtitle text-secondary">Crea la primera asignación para esta materia.</p>
                                <div class="empty-action">
                                    <a href="@Url.Action("CrearAsignacion", "Asignaciones")" class="btn btn-primary">+ Nueva asignación</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div id="sinResultadosAsignaciones" class="alert alert-info" style="display:none">
            No hay asignaciones que coincidan con este filtro.
        </div>
    </div>

    @* ===================== TAB: ASISTENCIA ===================== *@
    <div class="tab-pane fade" id="tab-asistencia" role="tabpanel">

        @using (Html.BeginForm("GuardarAsistencia", "AulaVirtual", FormMethod.Post, new { id = "formAsistencia" }))
        {
            @Html.AntiForgeryToken()

            <div class="card shadow-sm mb-3">
                <div class="card-body d-flex align-items-end flex-wrap gap-3">
                    <div>
                        <label class="form-label">Fecha</label>
                        <input type="date" name="fecha" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="ms-auto d-flex gap-2">
                        <button type="button" class="btn btn-outline-success btn-sm" id="btnTodosPresentes">Marcar todos presentes</button>
                        <button type="submit" class="btn btn-cyan btn-sm">Guardar asistencia</button>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">Lista de asistencia</h3>
                    <div class="small text-secondary">
                        Presentes: <span id="contPresentes" class="fw-bold text-success">@estudiantes.Count</span> ·
                        Tardías: <span id="contTardias" class="fw-bold text-warning">0</span> ·
                        Ausencias: <span id="contAusentes" class="fw-bold text-danger">0</span>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>Estudiante</th>
                                <th>Estado de asistencia</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < estudiantes.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <span class="avatar avatar-sm rounded-circle bg-teal-lt fw-bold me-2">@estudiantes[i].Substring(0, 1).ToUpper()</span>
                                            @estudiantes[i]
                                        </div>
                                    </td>
                                    <td>
                                        <div class="btn-group asistencia-grupo" role="group">
                                            <input type="radio" class="btn-check" name="asistencia_@i" id="presente_@i" value="Presente" checked autocomplete="off">
                                            <label class="btn btn-sm btn-outline-success" for="presente_@i">Presente</label>

                                            <input type="radio" class="btn-check" name="asistencia_@i" id="tardia_@i" value="Tardía" autocomplete="off">
                                            <label class="btn btn-sm btn-outline-warning" for="tardia_@i">Tardía</label>

                                            <input type="radio" class="btn-check" name="asistencia_@i" id="ausenteJust_@i" value="Ausencia justificada" autocomplete="off">
                                            <label class="btn btn-sm btn-outline-info" for="ausenteJust_@i">Ausencia justificada</label>

                                            <input type="radio" class="btn-check" name="asistencia_@i" id="ausenteInjust_@i" value="Ausencia no justificada" autocomplete="off">
                                            <label class="btn btn-sm btn-outline-danger" for="ausenteInjust_@i">Ausencia no justificada</label>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div class="text-secondary small mt-2">
            Al guardar una ausencia se notificará automáticamente al correo del padre/encargado registrado.
        </div>
    </div>

    @* ===================== TAB: MATERIAL Y COMUNICADOS ===================== *@
    <div class="tab-pane fade" id="tab-material" role="tabpanel">
        <div class="row g-3">

            <!-- Material de la materia -->
            <div class="col-lg-7">
                <div class="card shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h3 class="card-title mb-0">Material publicado</h3>
                        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalMaterial">+ Publicar material</button>
                    </div>
                    @if (materiales.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var m in materiales)
                            {
                                <div class="list-group-item d-flex align-items-center">
                                    <span class="avatar avatar-sm bg-blue-lt me-3">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon">
                                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                            <path d="M14 3v4a1 1 0 0 0 1 1h4" />
                                            <path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z" />
                                        </svg>
                                    </span>
                                    <div class="flex-fill">
                                        <div class="fw-medium">@m.Nombre</div>
                                        <div class="text-secondary small">@m.Tipo · Publicado el @m.Fecha</div>
                                    </div>
                                    <a href="@m.Url" class="btn btn-sm btn-outline-secondary">Descargar</a>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="card-body">
                            <div class="empty">
                                <p class="empty-title">No hay material publicado</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Comunicados / recordatorios -->
            <div class="col-lg-5">
                <div class="card shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h3 class="card-title mb-0">Comunicados</h3>
                        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalComunicado">+ Nuevo</button>
                    </div>
                    @if (comunicados.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var c in comunicados)
                            {
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between">
                                        <div class="fw-medium">@c.Titulo</div>
                                        <div class="text-secondary small">@c.Fecha</div>
                                    </div>
                                    <p class="text-secondary small mb-1">@c.Mensaje</p>
                                    <div class="text-secondary small">— @c.Autor</div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="card-body">
                            <div class="empty">
                                <p class="empty-title">No hay comunicados</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>

</div>

@* ===================== MODAL: Publicar material ===================== *@
<div class="modal modal-blur fade" id="modalMaterial" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            @using (Html.BeginForm("PublicarMaterial", "AulaVirtual", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Publicar material</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nombre del material</label>
                        <input type="text" name="nombreMaterial" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tipo</label>
                        <select name="tipoMaterial" class="form-select">
                            <option value="Archivo">Archivo (PDF, Word, PPTX...)</option>
                            <option value="Enlace">Enlace externo</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Archivo o URL</label>
                        <input type="file" name="archivoMaterial" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-link" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Publicar</button>
                </div>
            }
        </div>
    </div>
</div>

@* ===================== MODAL: Nuevo comunicado ===================== *@
<div class="modal modal-blur fade" id="modalComunicado" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            @using (Html.BeginForm("PublicarComunicado", "AulaVirtual", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Nuevo comunicado</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Título</label>
                        <input type="text" name="tituloComunicado" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mensaje</label>
                        <textarea name="mensajeComunicado" class="form-control" rows="4" required></textarea>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" name="notificarPadres" id="notificarPadres" value="true" checked>
                        <label class="form-check-label" for="notificarPadres">Notificar también a los padres/encargados</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-link" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Publicar comunicado</button>
                </div>
            }
        </div>
    </div>
</div>
