@model IEnumerable<EduNexus.Abstracciones.ModelosParaUI.Docentes.DocentesDto>

@{
    ViewBag.Title = "Listado de docentes";
    int total = Model.Count();
    int activos = Model.Count(x => x.estado == "Activo");
    int inactivos = total - activos;
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Académico</div>
            <h2 class="page-title">Docentes</h2>
            <div class="page-subtitle">Registre docentes y abra su ficha para gestionar las materias y secciones que imparten.</div>
        </div>
        <div class="col-12 col-md-auto ms-auto">
            <div class="btn-list">
                @Html.ActionLink("Horario de docentes", "BuscarDocente", "HorarioDocentes", null, new { @class = "btn btn-outline-secondary" })
                @Html.ActionLink("Nuevo docente", "CrearDocente", null, new { @class = "btn btn-primary" })
            </div>
        </div>
    </div>
</div>

<div class="row row-cards g-3 mb-3">
    <div class="col-sm-4">
        <div class="card card-sm">
            <div class="card-body">
                <div class="text-secondary small">Total de docentes</div>
                <div class="h2 mb-0">@total</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card card-sm">
            <div class="card-body">
                <div class="text-secondary small">Activos</div>
                <div class="h2 mb-0 text-success">@activos</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card card-sm">
            <div class="card-body">
                <div class="text-secondary small">Inactivos</div>
                <div class="h2 mb-0 text-danger">@inactivos</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Listado de docentes</h3>
        <div class="card-actions text-secondary small">@total docente(s)</div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty">
            <div class="empty-icon">
                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" /><path d="M6 21v-2a4 4 0 0 1 4 -4h4" /><path d="M15 19l2 2l4 -4" /></svg>
            </div>
            <p class="empty-title">No hay docentes registrados</p>
            <p class="empty-subtitle text-secondary">Cuando agregue un docente aparecerá en este listado.</p>
            <div class="empty-action">
                @Html.ActionLink("Nuevo docente", "CrearDocente", null, new { @class = "btn btn-primary" })
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vcenter card-table" id="myTable">
                <thead>
                    <tr>
                        <th>Docente</th>
                        <th>@Html.DisplayNameFor(model => model.identificacion)</th>
                        <th>@Html.DisplayNameFor(model => model.email)</th>
                        <th>@Html.DisplayNameFor(model => model.telefono)</th>
                        <th>@Html.DisplayNameFor(model => model.estado)</th>
                        <th class="en-acciones">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        string inicial = (item.nombre ?? "?").Substring(0, 1).ToUpper();
                        string estadoBadge = item.estado == "Activo" ? "green" : "red";
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <span class="avatar avatar-sm rounded-circle bg-blue-lt fw-bold me-2">@inicial</span>
                                    <div class="fw-medium">@Html.ActionLink(item.nombre + " " + item.apellido1 + " " + item.apellido2, "CargaAcademicaDocente", new { id = item.id_docente })</div>
                                </div>
                            </td>
                            <td class="text-nowrap">@Html.DisplayFor(modelItem => item.identificacion)</td>
                            <td><a href="mailto:@item.email">@item.email</a></td>
                            <td class="text-nowrap">@Html.DisplayFor(modelItem => item.telefono)</td>
                            <td><span class="badge bg-@(estadoBadge)-lt">@item.estado</span></td>
                            <td class="en-acciones">
                                <div class="btn-list">
                                    @Html.ActionLink("Ver ficha", "CargaAcademicaDocente", new { id = item.id_docente }, new { @class = "btn btn-sm btn-outline-primary" })
                                    @Html.ActionLink("Editar", "EditarDocente", new { id = item.id_docente }, new { @class = "btn btn-sm btn-outline-secondary" })
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section scripts
{
    <script src="~/Scripts/General/General.js"></script>
}
