@model EduNexus.Abstracciones.ModelosParaUI.AsignacionesDocentes.AsignacionDocenteDto

@{
    ViewBag.Title = "Asignar materia y sección";

    var disponibles = (ViewBag.HorariosDisponibles as System.Collections.Generic.List<EduNexus.Abstracciones.ModelosParaUI.Horarios.HorariosDto>)
                      ?? new System.Collections.Generic.List<EduNexus.Abstracciones.ModelosParaUI.Horarios.HorariosDto>();
    var nombresMaterias = (ViewBag.NombresMaterias as System.Collections.Generic.Dictionary<int, string>)
                          ?? new System.Collections.Generic.Dictionary<int, string>();
    var nombresSecciones = (ViewBag.NombresSecciones as System.Collections.Generic.Dictionary<int, string>)
                           ?? new System.Collections.Generic.Dictionary<int, string>();
    var materias = (ViewBag.Materias as System.Web.Mvc.SelectList)
                   ?? new System.Web.Mvc.SelectList(new System.Collections.Generic.List<System.Web.Mvc.SelectListItem>());
    var secciones = (ViewBag.Secciones as System.Web.Mvc.SelectList)
                    ?? new System.Web.Mvc.SelectList(new System.Collections.Generic.List<System.Web.Mvc.SelectListItem>());

    System.Func<System.Collections.Generic.Dictionary<int, string>, int, string> nombre =
        (d, k) => d.ContainsKey(k) ? d[k] : "";
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Académico</div>
            <h2 class="page-title">Asignar materia y sección</h2>
            <div class="page-subtitle">
                Seleccione una materia y sección para el docente:
                <strong><a href="@Url.Action("CargaAcademicaDocente", new { id = Model.id_docente })">@ViewBag.NombreDocente</a></strong>.
                Si la clase ya tenía otro docente, este lo reemplaza.
            </div>
        </div>
    </div>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.id_docente)
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

    <!-- Contenedor principal -->
    <div class="row g-3">
        <div class="col-lg-8">
            <!-- Cards de selección -->
            <div class="card mb-3">
                <div class="card-header">
                    <h3 class="card-title">Datos de la asignación</h3>
                </div>
                <div class="card-body">

                    <!-- Paso 1: Seleccionar Materia -->
                    <div class="mb-3">
                        <div class="d-flex align-items-center mb-2">
                            <span class="hz-step">1</span>
                            <div>
                                <h4 class="mb-1">Materia <span class="text-danger">*</span></h4>
                                <p class="text-secondary small mb-0">¿Cuál es la materia que impartirá?</p>
                            </div>
                        </div>
                        <div class="form-group mt-3">
                            @Html.DropDownListFor(
                                model => model.id_materia,
                                materias,
                                "-- Seleccione una materia --",
                                new { @class = "form-select", @id = "selectMateria" }
                            )
                            @Html.ValidationMessageFor(model => model.id_materia, "", new { @class = "text-danger small mt-2" })
                        </div>
                    </div>

                    <hr class="my-3">

                    <!-- Paso 2: Seleccionar Sección -->
                    <div class="mb-3">
                        <div class="d-flex align-items-center mb-2">
                            <span class="hz-step">2</span>
                            <div>
                                <h4 class="mb-1">Sección <span class="text-danger">*</span></h4>
                                <p class="text-secondary small mb-0">¿A cuál sección le impartirá esta materia?</p>
                            </div>
                        </div>
                        <div class="form-group mt-3">
                            @Html.DropDownListFor(
                                model => model.id_seccion,
                                secciones,
                                "-- Seleccione una sección --",
                                new { @class = "form-select", @id = "selectSeccion" }
                            )
                            @Html.ValidationMessageFor(model => model.id_seccion, "", new { @class = "text-danger small mt-2" })
                        </div>
                    </div>

                    <hr class="my-3">

                    <!-- Paso 3: Ver horarios disponibles -->
                    <div class="mb-3">
                        <div class="d-flex align-items-center mb-2">
                            <span class="hz-step">3</span>
                            <div>
                                <h4 class="mb-1">Horario de la clase</h4>
                                <p class="text-secondary small mb-0">Al asignar se verifica que el docente no tenga choques con estos bloques.</p>
                            </div>
                        </div>

                        <!-- Estado inicial -->
                        <div id="hdInicio" class="alert alert-info">
                            <span>Seleccione materia y sección para ver el horario registrado de esa clase.</span>
                        </div>

                        <!-- Tabla de horarios -->
                        <div class="table-responsive" id="hdTabla" style="display:none;">
                            <table class="table table-vcenter card-table border">
                                <thead>
                                    <tr>
                                        <th>Día</th>
                                        <th>Hora</th>
                                        <th>Materia</th>
                                        <th>Sección</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var h in disponibles)
                                    {
                                        <tr class="hd-fila" data-materia="@h.materia" data-seccion="@h.seccion" style="display:none;">
                                            <td class="text-nowrap">
                                                <span class="badge bg-blue-lt">@h.dia_semana</span>
                                            </td>
                                            <td class="text-nowrap">
                                                <strong>@EduNexus.UI.Models.HorarioServicio.Hora(h.hora_inicio)</strong> - <small>@EduNexus.UI.Models.HorarioServicio.Hora(h.hora_fin)</small>
                                            </td>
                                            <td>@nombre(nombresMaterias, h.materia)</td>
                                            <td>@nombre(nombresSecciones, h.seccion)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Sin horarios disponibles -->
                        <div id="hdVacio" style="display:none;">
                            <div class="alert alert-warning">
                                <strong>Atención:</strong> Esta materia aún no tiene horario en la sección seleccionada.
                                Después de asignarla podrá registrarlo en
                                <a href="@Url.Action("ListadoDeHorarios", "Horarios")" class="alert-link">Horarios</a>.
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Botones de acción -->
            <div class="en-form-acciones mb-3">
                <a href="@Url.Action("CargaAcademicaDocente", new { id = Model.id_docente })" class="btn btn-outline-secondary">
                    Cancelar
                </a>
                <button type="submit" id="hdAsignar" class="btn btn-primary" disabled>
                    Guardar
                </button>
            </div>
        </div>

        <!-- Panel lateral: Resumen -->
        <div class="col-lg-4">
            <div class="card sticky-lg-top" style="top: 20px;">
                <div class="card-header">
                    <h3 class="card-title">Resumen de la asignación</h3>
                </div>
                <div class="card-body">

                    <div class="mb-3">
                        <div class="en-dato-label">Docente</div>
                        <p class="mb-0 fw-bold">@ViewBag.NombreDocente</p>
                    </div>

                    <div class="mb-3">
                        <div class="en-dato-label">Materia seleccionada</div>
                        <p id="resumenMateria" class="mb-0 fw-bold text-muted">No seleccionada</p>
                    </div>

                    <div class="mb-3">
                        <div class="en-dato-label">Sección seleccionada</div>
                        <p id="resumenSeccion" class="mb-0 fw-bold text-muted">No seleccionada</p>
                    </div>

                    <hr>

                    <div class="alert alert-success mb-0" id="alertaConfirmacion" style="display:none;">
                        <strong>¡Listo!</strong> Puede confirmar la asignación.
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section scripts {
    <script src="~/Scripts/Docentes/AsignarDocente.js"></script>
}
