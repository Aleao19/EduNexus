@model EduNexus.Abstracciones.ModelosParaUI.Docentes.DocentesDto

@{
    ViewBag.Title = "Editar docente";
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Académico</div>
            <h2 class="page-title">Editar docente</h2>
            <div class="page-subtitle">Actualice la información del docente.</div>
        </div>
    </div>
</div>

<div class="card">
    @using (Html.BeginForm("Edit", "Docentes", new { id = Model.id_docente }, FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.id_docente)
        <div class="card-header">
            <h3 class="card-title">Datos del docente</h3>
        </div>
        <div class="card-body">
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="row g-3">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.identificacion, new { @class = "form-label" })
                    <input type="text" id="identificacion_lectura" class="form-control" value="@Model.identificacion" readonly disabled />
                    <small class="form-hint">La cédula no es modificable.</small>
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(model => model.nombre, new { @class = "form-label required" })
                    @Html.TextBoxFor(model => model.nombre, new { @class = "form-control", placeholder = "Nombre", required = "required" })
                    @Html.ValidationMessageFor(model => model.nombre, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(model => model.apellido1, new { @class = "form-label required" })
                    @Html.TextBoxFor(model => model.apellido1, new { @class = "form-control", placeholder = "Primer apellido", required = "required" })
                    @Html.ValidationMessageFor(model => model.apellido1, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(model => model.apellido2, new { @class = "form-label" })
                    @Html.TextBoxFor(model => model.apellido2, new { @class = "form-control", placeholder = "Segundo apellido" })
                    @Html.ValidationMessageFor(model => model.apellido2, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(model => model.email, new { @class = "form-label required" })
                    @Html.TextBoxFor(model => model.email, new { @class = "form-control", type = "email", placeholder = "usuario@mep.go.cr", required = "required" })
                    @Html.ValidationMessageFor(model => model.email, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(model => model.telefono, new { @class = "form-label" })
                    @Html.TextBoxFor(model => model.telefono, new { @class = "form-control", type = "tel", placeholder = "8888-8888" })
                    @Html.ValidationMessageFor(model => model.telefono, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(model => model.estado, new { @class = "form-label required" })
                    <select id="estado" name="estado" class="form-select" required>
                        <option value="">-- Seleccione un estado --</option>
                        <option value="Activo" @(Model.estado == "Activo" ? "selected" : "")>Activo</option>
                        <option value="Inactivo" @(Model.estado == "Inactivo" ? "selected" : "")>Inactivo</option>
                    </select>
                    @Html.ValidationMessageFor(model => model.estado, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="card-footer en-form-acciones">
            @Html.ActionLink("Cancelar", "CargaAcademicaDocente", new { id = Model.id_docente }, new { @class = "btn btn-outline-secondary" })
            <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        // Validación del formulario
        (function () {
            'use strict';
            window.addEventListener('load', function () {
                var forms = document.getElementsByClassName('needs-validation');
                var validation = Array.prototype.filter.call(forms, function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
            }, false);
        })();
    </script>
}
