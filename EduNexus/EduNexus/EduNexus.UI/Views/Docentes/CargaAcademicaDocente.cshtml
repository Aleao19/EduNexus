@model IEnumerable<EduNexus.Abstracciones.ModelosParaUI.AsignacionesDocentes.AsignacionDocenteDto>

@{
    ViewBag.Title = "Ficha del docente";
    var asignaciones = Model.ToList();
    var docente = (ViewBag.Docente as EduNexus.Abstracciones.ModelosParaUI.Docentes.DocentesDto)
                  ?? new EduNexus.Abstracciones.ModelosParaUI.Docentes.DocentesDto();
    string nombreDocente = (ViewBag.NombreDocente ?? "").ToString();
    string inicial = string.IsNullOrEmpty(nombreDocente) ? "?" : nombreDocente.Substring(0, 1).ToUpper();
    bool activo = docente.estado == "Activo";
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col-auto">
            <span class="avatar avatar-md rounded-circle bg-blue-lt fw-bold">@inicial</span>
        </div>
        <div class="col">
            <div class="page-pretitle">
                @Html.ActionLink("Docentes", "ListadoDeDocentes") / Ficha del docente
            </div>
            <h2 class="page-title d-flex align-items-center flex-wrap gap-2">
                @nombreDocente
                <span class="badge bg-@(activo ? "green" : "red")-lt">@docente.estado</span>
            </h2>
            <div class="page-subtitle">Desde esta ficha se gestionan las materias y secciones que imparte el docente.</div>
        </div>
        <div class="col-12 col-md-auto ms-auto">
            <div class="btn-list">
                @Html.ActionLink("Ver horario", "HorarioDeDocente", "HorarioDocentes", new { id = docente.id_docente }, new { @class = "btn btn-outline-secondary" })
                @Html.ActionLink("Editar datos", "EditarDocente", new { id = docente.id_docente }, new { @class = "btn btn-outline-secondary" })
                @if (activo)
                {
                    @Html.ActionLink("Asignar materia y sección", "AsignarDocente", new { id = docente.id_docente }, new { @class = "btn btn-primary" })
                }
            </div>
        </div>
    </div>
</div>

@if (!activo)
{
    <div class="alert alert-warning">
        El docente está inactivo. Para asignarle materias y secciones, primero actívelo en
        @Html.ActionLink("Editar datos", "EditarDocente", new { id = docente.id_docente }, new { @class = "alert-link" }).
    </div>
}

<div class="row row-cards g-3 mb-3">
    <!-- Datos del docente -->
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">
                <h3 class="card-title">Datos del docente</h3>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Cédula</dt>
                    <dd class="col-7">@docente.identificacion</dd>
                    <dt class="col-5">Correo</dt>
                    <dd class="col-7 text-break"><a href="mailto:@docente.email">@docente.email</a></dd>
                    <dt class="col-5">Teléfono</dt>
                    <dd class="col-7">@(string.IsNullOrWhiteSpace(docente.telefono) ? "—" : docente.telefono)</dd>
                    <dt class="col-5">Estado</dt>
                    <dd class="col-7 mb-0"><span class="badge bg-@(activo ? "green" : "red")-lt">@docente.estado</span></dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Resumen de la carga -->
    <div class="col-lg-8">
        <div class="row row-cards g-3">
            <div class="col-sm-4">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="text-secondary small">Clases a cargo</div>
                        <div class="h2 mb-0">@asignaciones.Count</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="text-secondary small">Materias distintas</div>
                        <div class="h2 mb-0">@asignaciones.Select(a => a.id_materia).Distinct().Count()</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="card card-sm">
                    <div class="card-body">
                        <div class="text-secondary small">Secciones a cargo</div>
                        <div class="h2 mb-0">@asignaciones.Select(a => a.id_seccion).Distinct().Count()</div>
                    </div>
                </div>
            </div>
            <div class="col-12">
                <div class="alert alert-info mb-0">
                    Una clase (materia + sección) tiene un solo docente. Si asigna aquí una clase que ya tenía otro
                    docente, este lo reemplaza. Para quitar una clase que ya tiene horario, asistencia o notas,
                    reasigne otro docente en su lugar desde la ficha de ese docente.
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Materias y secciones asignadas -->
<div class="card">
    <div class="card-header">
        <h3 class="card-title">Materias y secciones asignadas</h3>
        <div class="card-actions text-secondary small">@asignaciones.Count clase(s)</div>
    </div>

    @if (!asignaciones.Any())
    {
        <div class="card-body p-0">
            <div class="empty">
                <div class="empty-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M3 19a9 9 0 0 1 9 0a9 9 0 0 1 9 0" /><path d="M3 6a9 9 0 0 1 9 0a9 9 0 0 1 9 0" /><path d="M3 6v13" /><path d="M12 6v13" /><path d="M21 6v13" /></svg>
                </div>
                <p class="empty-title">Sin materias asignadas</p>
                <p class="empty-subtitle text-secondary">
                    Este docente aún no imparte ninguna materia. Asígnele su primera materia y sección.
                </p>
                @if (activo)
                {
                    <div class="empty-action">
                        @Html.ActionLink("Asignar materia y sección", "AsignarDocente", new { id = docente.id_docente }, new { @class = "btn btn-primary" })
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>Materia</th>
                        <th>Sección</th>
                        <th>Estudiantes</th>
                        <th>Horario</th>
                        <th>Asignada el</th>
                        <th class="en-acciones">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in asignaciones)
                    {
                        <tr>
                            <td class="fw-medium">@a.materia</td>
                            <td>@a.seccion</td>
                            <td>@a.estudiantes_matriculados / @a.cupo</td>
                            <td>
                                @if (a.bloques_horario > 0)
                                {
                                    <span class="badge bg-green-lt">@a.bloques_horario bloque(s)</span>
                                }
                                else
                                {
                                    <span class="badge bg-yellow-lt">Sin horario</span>
                                }
                            </td>
                            <td class="text-secondary">@(a.fecha_asignacion.HasValue ? a.fecha_asignacion.Value.ToString("dd/MM/yyyy") : "—")</td>
                            <td class="en-acciones">
                                <div class="btn-list">
                                    @Html.ActionLink("Materias de la sección", "ListadoDeAsignaciones", "SeccionMaterias", new { seccion = a.id_seccion }, new { @class = "btn btn-sm btn-outline-secondary" })
                                    @using (Html.BeginForm("QuitarAsignacion", "Docentes", FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('¿Desea quitar a este docente de " + a.materia.Replace("'", "") + " en " + a.seccion.Replace("'", "") + "? La materia quedará sin asignar en esa sección.');" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@a.id_asignacion_docente" />
                                        <input type="hidden" name="idDocente" value="@docente.id_docente" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Quitar</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="mt-3">
    <a href="@Url.Action("ListadoDeDocentes")" class="btn btn-outline-secondary">
        Volver al listado de docentes
    </a>
</div>
