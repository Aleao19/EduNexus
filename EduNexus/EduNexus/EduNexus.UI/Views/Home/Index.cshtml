@{
    ViewBag.Title = "Home Page";
}

<main>
    <section class="row" aria-labelledby="appTitle">
        <h1 id="title">Administración</h1>        
    </section>

    <div class="row row-deck p-3 g-4">
        <!-- Secciones -->
        <div class="col-md-4">
            <div class="card card-md card-link position-relative shadow-sm">
                <div class="card-stamp">
                    <div class="card-stamp-icon bg-blue">
                        <!-- Icono: Folder/Secciones -->
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M5 4h4l3 3h7a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10a2 2 0 0 1 2 -2" />
                        </svg>
                    </div>
                </div>
                <div class="card-body">
                    <h3 class="card-title">
                        @Html.ActionLink("Secciones", "ListadoDeSecciones", "Secciones", null, new { @class = "stretched-link text-decoration-none color-inherit" })
                    </h3>
                    <p class="text-secondary mb-0">Gestión de secciones académicas.</p>
                </div>
            </div>
        </div>

        <!-- Horarios -->
        <div class="col-md-4">
            <div class="card card-md card-link position-relative shadow-sm">
                <div class="card-stamp">
                    <div class="card-stamp-icon bg-green">
                        <!-- Icono: Clock/Horarios -->
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" />
                            <path d="M12 7v5l3 3" />
                        </svg>
                    </div>
                </div>
                <div class="card-body">
                    <h3 class="card-title">
                        @Html.ActionLink("Horarios", "ListadoDeHorarios", "Horarios", null, new { @class = "stretched-link text-decoration-none color-inherit" })
                    </h3>
                    <p class="text-secondary mb-0">Gestión panificación de haraios.</p>
                </div>
            </div>
        </div>

        <!-- Materias -->
        <div class="col-md-4">
            <div class="card card-md card-link position-relative shadow-sm">
                <div class="card-stamp">
                    <div class="card-stamp-icon bg-purple">
                        <!-- Icono: Book/Materias -->
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M3 19a9 9 0 0 1 9 0a9 9 0 0 1 9 0" />
                            <path d="M3 6a9 9 0 0 1 9 0a9 9 0 0 1 9 0" />
                            <path d="M3 6v13" />
                            <path d="M12 6v13" />
                            <path d="M21 6v13" />
                        </svg>
                    </div>
                </div>
                <div class="card-body">
                    <h3 class="card-title">
                        @Html.ActionLink("Materias", "ListadoDeMaterias", "Materias", null, new { @class = "stretched-link text-decoration-none color-inherit" })
                    </h3>
                    <p class="text-secondary mb-0">Gestión de ssignaturas y Docente encargado.</p>
                </div>
            </div>
        </div>

        <!-- Docentes -->
        <div class="col-md-4">
            <div class="card card-md card-link position-relative shadow-sm">
                <div class="card-stamp">
                    <div class="card-stamp-icon bg-orange">
                        <!-- Icono: User-Check/Docentes -->
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
                            <path d="M6 21v-2a4 4 0 0 1 4 -4h4" />
                            <path d="M15 19l2 2l4 -4" />
                        </svg>
                    </div>
                </div>
                <div class="card-body">
                    <h3 class="card-title">
                        @Html.ActionLink("Docentes", "ListadoDeDocentes", "Docentes", null, new { @class = "stretched-link text-decoration-none color-inherit" })
                    </h3>
                    <p class="text-secondary mb-0">Gestión de docentes.</p>
                </div>
            </div>
        </div>

        <!-- Estudiantes -->
        <div class="col-md-4">
            <div class="card card-md card-link position-relative shadow-sm">
                <div class="card-stamp">
                    <div class="card-stamp-icon bg-teal">
                        <!-- Icono: Users/Estudiantes -->
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M9 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
                            <path d="M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />
                            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                            <path d="M21 21v-2a4 4 0 0 0 -3 -3.85" />
                        </svg>
                    </div>
                </div>
                <div class="card-body">
                    <h3 class="card-title">
                        @Html.ActionLink("Estudiantes", "ListadoDeExpedientes", "Estudiantes", null, new { @class = "stretched-link text-decoration-none color-inherit" })
                    </h3>
                    <p class="text-secondary mb-0">Registro y expedientes de alumnos.</p>
                </div>
            </div>
        </div>

        <!-- Auditoría -->
        <div class="col-md-4">
            <div class="card card-md card-link position-relative shadow-sm">
                <div class="card-stamp">
                    <div class="card-stamp-icon bg-yellow">
                        <!-- Icono: Shield-Check/Auditoría -->
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3" />
                            <path d="M9 12l2 2l4 -4" />
                        </svg>
                    </div>
                </div>
                <div class="card-body">
                    <h3 class="card-title">
                        @Html.ActionLink("Auditoría", "Bitacora", "Home", null, new { @class = "stretched-link text-decoration-none color-inherit" })
                    </h3>
                    <p class="text-secondary mb-0">Registro de actividades y bitácora.</p>
                </div>
            </div>
        </div>
    </div>
</main>
