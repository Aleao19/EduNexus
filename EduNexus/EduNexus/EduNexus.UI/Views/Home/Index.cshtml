@{
    ViewBag.Title = "Home Page";
}

<main>
    <section class="row" aria-labelledby="appTitle">
        <h1 id="title">Administración</h1>        
    </section>

    <div class="row row-deck p-3 g-4">
        <div class="col-md-4">
            <div class="card card-md card-link position-relative border-info">
                <div class="card-body">
                    @Html.ActionLink("Secciones", "ListadoDeSecciones", "Secciones", null, new { @class = "stretched-link text-decoration-none color-inherit" })
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-md  card-link position-relative border-info">
                <div class="card-body">Horarios</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-md card-link position-relative border-info">
                <div class="card-body">Materias</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-md card-link position-relative border-info">
                <div class="card-body">Docentes</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-md card-link position-relative border-info">
                <div class="card-body">Estudiantes</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-md card-link position-relative border-info">
                <div class="card-body">Auditoria</div>
            </div>
        </div>
