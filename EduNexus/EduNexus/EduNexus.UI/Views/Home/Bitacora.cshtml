@model IEnumerable<EduNexus.Abstracciones.ModelosParaUI.Bitacora.BitacoraDto>

@{
    ViewBag.Title = "Bitácora";
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Seguridad</div>
            <h2 class="page-title">Bitácora de auditoría</h2>
            <div class="page-subtitle">Registro de las acciones realizadas en el sistema, con los datos antes y después de cada cambio.</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Eventos registrados</h3>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table" id="myTable">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.tipoDeEvento)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.descripcionEvento)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.fecha)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.datosAnteriores)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.datosPosteriores)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Usuario)
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <span class="badge bg-blue-lt">@Html.DisplayFor(modelItem => item.tipoDeEvento)</span>
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.descripcionEvento)
                        </td>
                        <td class="text-nowrap text-secondary">
                            @Html.DisplayFor(modelItem => item.fecha)
                        </td>
                        <td class="small text-secondary text-break-all">
                            @Html.DisplayFor(modelItem => item.datosAnteriores)
                        </td>
                        <td class="small text-secondary text-break-all">
                            @Html.DisplayFor(modelItem => item.datosPosteriores)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Usuario)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@section scripts
{
    <script src="~/Scripts/General/General.js"></script>
}
